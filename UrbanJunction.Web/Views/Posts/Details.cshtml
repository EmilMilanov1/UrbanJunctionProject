@model UrbanJunction.Data.Models.Post
@{
    ViewData["Title"] = "Post Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool userLiked = (bool)(ViewBag.UserLiked ?? false);
    int likeCount = (int)(ViewBag.LikeCount ?? 0);
    string topicName = Model.Subcategory?.Topic?.Name ?? "";
    string topicClass = topicName.ToLower() switch
    {
        "art" => "art",
        "music" => "music",
        "fashion" => "fashion",
        _ => "default"
    };
    string topicColor = topicClass switch
    {
        "art" => "#4caf72",
        "music" => "#6c63ff",
        "fashion" => "#f5a623",
        _ => "#e85d4a"
    };
}

<div style="max-width:760px;margin:0 auto;padding:32px 16px;">

    <!-- Back -->
    <a onclick="history.back()"
       class="d-inline-flex align-items-center gap-2 mb-4 text-decoration-none"
       style="color:#6b6358;font-size:13px;cursor:pointer;">
        <i class="fa-solid fa-arrow-left fa-xs"></i> Back
    </a>

    <!-- Title + meta -->
    <div class="mb-3">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="uj-tag @topicClass">
                @Model.Subcategory?.Topic?.Name / @Model.Subcategory?.Name
            </span>
        </div>
        <h2 style="font-size:24px;font-weight:700;color:#e8e0d5;margin:0 0 10px;line-height:1.3;">
            @Model.Title
        </h2>
        <div class="d-flex align-items-center gap-2">
            @if (!string.IsNullOrEmpty(Model.User?.ProfilePicturePath))
            {
                <img src="@Model.User.ProfilePicturePath"
                     onerror="this.src='/images/default.jpg'"
                     style="width:30px;height:30px;border-radius:50%;object-fit:cover;" />
            }
            else
            {
                <div class="uj-avatar"
                     style="width:30px;height:30px;font-size:11px;background:linear-gradient(135deg,@topicColor,#111);">
                    @(Model.User?.UserName?.Length >= 2 ? Model.User.UserName.Substring(0, 2).ToUpper() : "?")
                </div>
            }
            <span style="font-size:13px;color:#a09880;">
                <strong style="color:#d0c8be;">@Model.User?.UserName</strong>
                · @Model.CreatedOn.ToString("dd MMM yyyy")
            </span>
        </div>
    </div>

    <hr />

    <!-- Content -->
    <div class="uj-detail-box mb-4">
        <p style="white-space:pre-wrap;margin:0;color:#d0c8be;line-height:1.7;">@Model.Content</p>
    </div>

    <!-- Images -->
    @if (Model.Images != null && Model.Images.Any())
    {
        <div id="detailsCarousel" class="carousel slide mb-4 rounded overflow-hidden" data-bs-ride="carousel">
            <div class="carousel-inner">
                @for (int i = 0; i < Model.Images.Count(); i++)
                {
                    var image = Model.Images.ElementAt(i);
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@image.ImagePath" class="d-block w-100"
                             style="max-height:500px;object-fit:cover;" alt="Post Image">
                    </div>
                }
            </div>
            @if (Model.Images.Count() > 1)
            {
                <button class="carousel-control-prev" type="button"
                        data-bs-target="#detailsCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button"
                        data-bs-target="#detailsCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            }
        </div>
    }

    <!-- Like / Comment bar -->
    <div class="d-flex align-items-center gap-3 mb-4">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-action="ToggleLike" asp-controller="Posts" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="d-flex align-items-center gap-2 btn p-0"
                        style="color:@(userLiked ? "#e25555" : "#6b6358");font-size:14px;background:none;border:none;">
                    <i class="@(userLiked ? "fa-solid" : "fa-regular") fa-heart"></i>
                    @(userLiked ? "Liked" : "Like") · @likeCount
                </button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login"
               class="d-flex align-items-center gap-2 text-decoration-none"
               style="color:#6b6358;font-size:14px;">
                <i class="fa-regular fa-heart"></i> Like · @likeCount
            </a>
        }

        <span class="d-flex align-items-center gap-2" style="color:#6b6358;font-size:14px;">
            <i class="fa-regular fa-comment"></i>
            @Model.Comments.Count() @(Model.Comments.Count() == 1 ? "Comment" : "Comments")
        </span>
    </div>

    <hr />

    <!-- Comments -->
    <div class="mb-4">
        <h5 style="color:#e8e0d5;font-size:16px;margin-bottom:16px;">Comments</h5>

        @if (!Model.Comments.Any())
        {
            <p style="color:#6b6358;font-size:14px;">No comments yet. Be the first!</p>
        }
        else
        {
            @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedOn))
            {
                <div class="uj-comment d-flex gap-3">
                    <img src="@(comment.User?.ProfilePicturePath ?? "/images/default.jpg")"
                         onerror="this.src='/images/default.jpg'"
                         style="width:34px;height:34px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span style="color:#a09880;font-size:13px;font-weight:600;">
                                @comment.User?.UserName
                            </span>
                            <span style="color:#6b6358;font-size:11px;">
                                @comment.CreatedOn.ToString("dd MMM yyyy")
                            </span>
                        </div>
                        <p style="margin:0;color:#d0c8be;font-size:14px;white-space:pre-wrap;line-height:1.5;">
                            @comment.Content
                        </p>
                        @if (User.Identity?.IsAuthenticated == true &&
                                        (comment.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                                        || User.IsInRole("Admin")))
                        {
                            <form asp-action="DeleteComment" asp-controller="Posts" method="post" class="mt-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="commentId" value="@comment.Id" />
                                <input type="hidden" name="postId" value="@Model.Id" />
                                <button type="submit" class="btn btn-link p-0"
                                        style="font-size:12px;color:#e85d4a;"
                                        onclick="return confirm('Delete this comment?')">
                                    Delete
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- Add comment -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="mb-4">
            <form asp-action="AddComment" asp-controller="Posts" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="input-group">
                    <input type="text" name="content" class="form-control"
                           placeholder="Write a comment..." maxlength="500" required />
                    <button type="submit" class="btn btn-info px-4">Post</button>
                </div>
            </form>
        </div>
    }
    else
    {
        <p style="color:#6b6358;font-size:14px;">
            <a asp-controller="Account" asp-action="Login" style="color:#e85d4a;">Log in</a>
            to like and comment.
        </p>
    }

</div>
@section Scripts {
    <script>
        document.querySelector('.navbar').style.setProperty('--topic-color', '@topicColor');
        document.querySelector('.navbar').classList.add('topic-tinted');
    </script>
}