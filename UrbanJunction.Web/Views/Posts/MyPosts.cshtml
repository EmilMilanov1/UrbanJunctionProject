@model IEnumerable<UrbanJunction.Data.Models.Post>

@{
    ViewData["Title"] = "My Posts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-end mb-4">
    <a asp-controller="Posts" asp-action="Create" class="btn btn-info">+ New Post</a>
</div>

<div class="container mt-5">
    <h2 class="text-center mb-5 text-white display-6">My Posts</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm py-4">
            You haven't posted anything yet.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var post in Model)
            {
                <div class="col">
                    <div class="card h-100 bg-dark text-light border-0 shadow-lg rounded-3 overflow-hidden">

                        @if (post.Images != null && post.Images.Any())
                        {
                            <img src="@post.Images.First().ImagePath"
                                 alt="Post Image"
                                 class="card-img-top"
                                 style="object-fit: cover; height: 220px;">
                        }

                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="card-title fw-bold text-info">@post.Title</h5>
                                <p class="card-text text-secondary">
                                    @(post.Content?.Length > 150 ? post.Content.Substring(0, 150) + "..." : post.Content)
                                </p>
                            </div>

                            <div class="mt-3">
                                <p class="card-text mb-2">
                                    <small class="text-muted">
                                        In <strong>@post.Subcategory?.Topic?.Name / @post.Subcategory?.Name</strong> •
                                        @post.CreatedOn.ToShortDateString()
                                    </small>
                                </p>

                                <!-- Likes & Comments row -->
                                <div class="d-flex gap-3 mb-3 text-muted">
                                    <span title="Likes">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-heart-fill text-danger me-1" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314" />
                                        </svg>
                                        @(post.Reactions?.Count ?? 0)
                                    </span>
                                    <span title="Comments">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chat-fill text-info me-1" viewBox="0 0 16 16">
                                            <path d="M8 15c4.418 0 8-3.134 8-7s-3.582-7-8-7-8 3.134-8 7c0 1.76.743 3.37 1.97 4.6-.097 1.016-.417 2.13-.771 2.966-.079.186.074.394.273.362 2.256-.37 3.597-.938 4.18-1.234A9 9 0 0 0 8 15" />
                                        </svg>
                                        @(post.Comments?.Count ?? 0)
                                    </span>
                                </div>

                                <!-- All 3 buttons always visible since this is the owner's page -->
                                <div class="d-flex gap-2">
                                    <a asp-action="Details"
                                       asp-controller="Posts"
                                       asp-route-id="@post.Id"
                                       class="btn btn-outline-info btn-sm flex-fill">
                                        View
                                    </a>

                                    <a asp-action="Edit"
                                       asp-controller="Posts"
                                       asp-route-id="@post.Id"
                                       class="btn btn-outline-warning btn-sm flex-fill">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-controller="Posts"
                                          asp-route-id="@post.Id"
                                          method="post"
                                          class="flex-fill">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm w-100"
                                                onclick="return confirm('Delete this post?')">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>