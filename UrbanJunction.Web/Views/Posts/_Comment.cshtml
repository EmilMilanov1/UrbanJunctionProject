@model UrbanJunction.Data.Models.Comment
@using UrbanJunction.Data.Models
@{
    string currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    bool canDelete = User.Identity?.IsAuthenticated == true &&
                     (Model.UserId == currentUserId || User.IsInRole("Admin"));
    bool canReport = User.Identity?.IsAuthenticated == true && Model.UserId != currentUserId;
    string reportModalId = $"reportComment{Model.Id}";
}

<div class="comment-thread" id="comment-@Model.Id">

    <div style="display:flex;gap:0.75rem;padding:0.85rem 0;">

        <img src="@(Model.User?.ProfilePicturePath ?? "/images/default.jpg")"
             onerror="this.src='/images/default.jpg'"
             style="width:34px;height:34px;border-radius:50%;object-fit:cover;
                    flex-shrink:0;border:1px solid var(--border-light);margin-top:2px;" />

        <div style="flex:1;min-width:0;">

            <!-- Header -->
            <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.3rem;">
                <span style="font-size:0.82rem;font-weight:600;color:var(--text);">
                    @Model.User?.UserName
                </span>
                <span style="font-family:var(--font-mono);font-size:0.7rem;color:var(--text-dim);">
                    @Model.CreatedOn.ToString("dd MMM yyyy")
                </span>
            </div>

            <!-- Content -->
            <p style="margin:0 0 0.4rem;color:var(--text-muted);font-size:0.9rem;line-height:1.6;">
                @Html.Raw(Model.Content?.Replace("\n", "<br/>") ?? "")
            </p>

            <!-- Actions -->
            <div style="display:flex;align-items:center;gap:1rem;">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button type="button"
                            onclick="toggleReplyForm(@Model.Id)"
                            style="background:none;border:none;padding:0;font-size:0.72rem;
                                   color:var(--text-dim);cursor:pointer;font-family:var(--font-body);
                                   transition:color 150ms;"
                            onmouseover="this.style.color='var(--text-muted)'"
                            onmouseout="this.style.color='var(--text-dim)'">
                        <i class="fa-solid fa-reply fa-xs me-1"></i>Reply
                    </button>
                }

                @if (canReport)
                {
                    <button type="button"
                            style="background:none;border:none;padding:0;font-size:0.72rem;
                                   color:var(--text-dim);cursor:pointer;font-family:var(--font-body);
                                   transition:color 150ms;"
                            onmouseover="this.style.color='var(--accent)'"
                            onmouseout="this.style.color='var(--text-dim)'"
                            data-bs-toggle="modal" data-bs-target="#@reportModalId"
                            title="Report comment">
                        <i class="fa-solid fa-flag fa-xs me-1"></i>Report
                    </button>
                }

                @if (canDelete)
                {
                    <form asp-action="DeleteComment" asp-controller="Posts" method="post"
                          style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="commentId" value="@Model.Id" />
                        <input type="hidden" name="postId" value="@Model.PostId" />
                        <button type="submit"
                                style="background:none;border:none;padding:0;font-size:0.72rem;
                                       color:var(--text-dim);cursor:pointer;font-family:var(--font-body);
                                       transition:color 150ms;"
                                onmouseover="this.style.color='var(--accent)'"
                                onmouseout="this.style.color='var(--text-dim)'"
                                onclick="return confirm('Delete this comment?')">
                            <i class="fa-solid fa-trash fa-xs me-1"></i>Delete
                        </button>
                    </form>
                }
            </div>

            <!-- Reply form -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div id="reply-form-@Model.Id" style="display:none;margin-top:0.75rem;">
                    <form asp-action="AddComment" asp-controller="Posts"
                          asp-route-id="@Model.PostId" method="post"
                          style="display:flex;gap:0.5rem;align-items:flex-start;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="parentCommentId" value="@Model.Id" />
                        <input type="text" name="content" class="form-control"
                               placeholder="Reply to @Model.User?.UserName..."
                               maxlength="500" required
                               style="font-size:0.85rem;" />
                        <button type="submit" class="btn-primary"
                                style="white-space:nowrap;padding:0.5rem 0.9rem;border:none;
                                       border-radius:6px;cursor:pointer;font-size:0.82rem;">
                            Reply
                        </button>
                        <button type="button"
                                onclick="toggleReplyForm(@Model.Id)"
                                style="white-space:nowrap;padding:0.5rem 0.75rem;border:1px solid var(--border);
                                       border-radius:6px;cursor:pointer;font-size:0.82rem;
                                       background:none;color:var(--text-dim);">
                            Cancel
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Nested replies -->
    @if (Model.Replies != null && Model.Replies.Any())
    {
        <div style="margin-left:2.75rem;border-left:2px solid var(--border);padding-left:1rem;">
            @foreach (var reply in Model.Replies.OrderBy(r => r.CreatedOn))
            {
                await Html.RenderPartialAsync("_Comment", reply);
            }
        </div>
    }

</div>

@if (!Model.ParentCommentId.HasValue)
{
    <div style="height:1px;background:var(--border);"></div>
}

<!-- Report Comment Modal -->
@if (canReport)
{
    <div class="modal fade" id="@reportModalId" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
            <div class="modal-content"
                 style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:10px;">
                <div class="modal-header" style="border-bottom:1px solid var(--border);">
                    <h6 class="modal-title"
                        style="font-family:var(--font-mono);font-size:0.7rem;
                               letter-spacing:0.12em;text-transform:uppercase;color:var(--text-dim);">
                        Report Comment
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Reports" asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="commentId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="/Posts/Details/@Model.PostId" />
                    <div class="modal-body" style="padding:1.25rem;">
                        <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1rem;">
                            Why are you reporting this comment?
                        </p>
                        <div style="display:flex;flex-direction:column;gap:0.5rem;">
                            @foreach (ReportReason r in Enum.GetValues(typeof(ReportReason)))
                            {
                                <label style="display:flex;align-items:center;gap:0.6rem;
                                              padding:0.55rem 0.75rem;border-radius:6px;
                                              border:1px solid var(--border);cursor:pointer;
                                              font-size:0.83rem;color:var(--text-muted);
                                              transition:border-color 150ms,color 150ms;"
                                       onmouseover="this.style.borderColor='var(--border-light)';this.style.color='var(--text)'"
                                       onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">
                                    <input type="radio" name="reason" value="@((int)r)"
                                           style="accent-color:var(--accent);" />
                                    @(r switch {
                                        ReportReason.Spam => "Spam",
                                        ReportReason.Harassment => "Harassment",
                                        ReportReason.HateSpeech => "Hate Speech",
                                        ReportReason.Misinformation => "Misinformation",
                                        ReportReason.InappropriateContent => "Inappropriate Content",
                                        _ => r.ToString()
                                    })
                                </label>
                            }
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid var(--border);padding:0.75rem 1.25rem;">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-bs-dismiss="modal">Cancel</button>
                        <button type="submit"
                                style="background:var(--accent);color:#fff;border:none;
                                       padding:0.4rem 1rem;border-radius:6px;font-size:0.82rem;cursor:pointer;">
                            Submit Report
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
