@model IEnumerable<UrbanJunction.Data.Models.Post>

@{
    ViewData["Title"] = ViewBag.TopicName;
    var likedPostIds = ViewBag.LikedPostIds as HashSet<int> ?? new HashSet<int>();
    string topicName = ViewBag.TopicName ?? "";
    string topicClass = topicName.ToLower() switch
    {
        "art"     => "art",
        "music"   => "music",
        "fashion" => "fashion",
        _         => "default"
    };
    string topicColor = topicClass switch
    {
        "art"     => "#4caf72",
        "music"   => "#7c6fff",
        "fashion" => "#f0a04b",
        _         => "#e85d4a"
    };
}

<div class="forum-main">

    <!-- Topic header -->
    <div class="topic-header">
        <div class="topic-title">
            <span class="topic-title-dot" style="background:@topicColor;"></span>
            @topicName
            <span style="font-size:0.8rem;font-weight:400;color:var(--text-dim);font-family:var(--font-mono);">
                @Model.Count() threads
            </span>
        </div>

        <div class="topic-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="thread-search" placeholder="Search threads…" autocomplete="off" />
        </div>
    </div>

    <!-- Subcategory tabs -->
    <div class="subcat-tabs">
        <span class="subcat-tab active" data-subcat="all">All</span>
        @if (topicClass == "art")
        {
            <span class="subcat-tab" data-subcat="Graffiti">Graffiti</span>
            <span class="subcat-tab" data-subcat="Photography">Photography</span>
            <span class="subcat-tab" data-subcat="Digital">Digital Art</span>
        }
        else if (topicClass == "music")
        {
            <span class="subcat-tab" data-subcat="HipHop">Hip-Hop</span>
            <span class="subcat-tab" data-subcat="Techno">Techno</span>
            <span class="subcat-tab" data-subcat="Indie">Indie</span>
        }
        else if (topicClass == "fashion")
        {
            <span class="subcat-tab" data-subcat="Streetwear">Streetwear</span>
            <span class="subcat-tab" data-subcat="Vintage">Vintage</span>
            <span class="subcat-tab" data-subcat="Designers">Designers</span>
        }
    </div>

    <!-- Sort + New Thread bar -->
    <div class="feed-controls">
        <div class="feed-controls-left">
            <span style="font-size:0.75rem;color:var(--text-dim);font-family:var(--font-mono);margin-right:0.25rem;">Sort:</span>
            <button class="sort-btn active" data-sort="new">New</button>
            <button class="sort-btn" data-sort="top">Top</button>
            <button class="sort-btn" data-sort="hot">Hot</button>
        </div>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <a asp-controller="Posts" asp-action="Create" class="new-thread-ribbon">
                <i class="fa-solid fa-plus fa-xs"></i> New Thread
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="new-thread-ribbon">
                <i class="fa-solid fa-plus fa-xs"></i> New Thread
            </a>
        }
    </div>

    <!-- Thread list -->
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:4rem 0;color:var(--text-dim);">
            <i class="fa-regular fa-face-sad-tear fa-2x" style="display:block;margin-bottom:0.75rem;"></i>
            No threads yet. Be the first to post.
        </div>
    }
    else
    {
        <div class="thread-list" id="posts-container">
            @foreach (var post in Model)
            {
                var isOwner = User.Identity?.IsAuthenticated == true &&
                              User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == post.UserId;
                var isAdmin    = User.IsInRole("Admin");
                var subcatName = post.Subcategory?.Name ?? "";
                var firstImage = post.Images?.FirstOrDefault()?.ImagePath;
                var reactionCount = (post.Reactions?.Count(r => r.IsUpvote) ?? 0) - (post.Reactions?.Count(r => !r.IsUpvote) ?? 0);
                var commentCount  = post.Comments?.Count() ?? 0;

                var preview = "";
                if (!string.IsNullOrEmpty(post.Content))
                {
                    preview = post.Content.Length > 120
                        ? post.Content.Substring(0, 120).TrimEnd() + "…"
                        : post.Content;
                }

                <div class="thread-row @(post.IsPinned ? "pinned" : "") @(post.IsLocked ? "locked" : "")"
                     data-subcat="@subcatName">

                    <!-- Vote strip -->
                    <div class="thread-vote">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button class="vote-btn upvote feed-vote-btn"
                                    data-post-id="@post.Id" data-is-upvote="true" title="Upvote">
                                <i class="fa-solid fa-chevron-up"></i>
                            </button>
                            <span class="vote-count feed-vote-score @(reactionCount > 0 ? "positive" : reactionCount < 0 ? "negative" : "")"
                                  data-post-id="@post.Id">
                                @reactionCount
                            </span>
                            <button class="vote-btn downvote feed-vote-btn"
                                    data-post-id="@post.Id" data-is-upvote="false" title="Downvote">
                                <i class="fa-solid fa-chevron-down"></i>
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="vote-btn upvote" title="Login to vote">
                                <i class="fa-solid fa-chevron-up"></i>
                            </a>
                            <span class="vote-count @(reactionCount > 0 ? "positive" : reactionCount < 0 ? "negative" : "")">
                                @reactionCount
                            </span>
                            <a asp-controller="Account" asp-action="Login" class="vote-btn downvote" title="Login to vote">
                                <i class="fa-solid fa-chevron-down"></i>
                            </a>
                        }
                    </div>

                    <!-- Thread content (text + thumbnail side by side) -->
                    <div class="thread-content">

                        <!-- Text block -->
                        <div class="thread-text">

                            <!-- Tags row -->
                            <div class="thread-tags">
                                <span class="thread-tag @topicClass">@topicName</span>
                                @if (post.IsPinned)
                                {
                                    <span class="thread-tag pinned"><i class="fa-solid fa-thumbtack fa-xs me-1"></i>Pinned</span>
                                }
                                @if (post.IsLocked)
                                {
                                    <span class="thread-tag locked"><i class="fa-solid fa-lock fa-xs me-1"></i>Locked</span>
                                }
                                @if (!string.IsNullOrEmpty(subcatName))
                                {
                                    <span class="thread-tag custom">@subcatName</span>
                                }
                                @if (isOwner || isAdmin)
                                {
                                    <form asp-action="Delete" asp-controller="Posts" asp-route-id="@post.Id"
                                          method="post" class="d-inline ms-auto">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="thread-tag custom"
                                                style="border:none;cursor:pointer;color:var(--accent);background:rgba(232,93,74,0.08);"
                                                onclick="return confirm('Delete this thread?')">
                                            <i class="fa-regular fa-trash-can fa-xs"></i>
                                        </button>
                                    </form>
                                }
                            </div>

                            <!-- Title -->
                            <div class="thread-title">
                                <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id">
                                    @post.Title
                                </a>
                            </div>

                            <!-- Preview text -->
                            @if (!string.IsNullOrEmpty(preview))
                            {
                                <div class="thread-preview">@preview</div>
                            }

                            <!-- Meta row -->
                            <div class="thread-meta">
                                <a asp-controller="Account" asp-action="UserProfile"
                                   asp-route-username="@post.User?.UserName"
                                   class="thread-author text-decoration-none">
                                    @if (!string.IsNullOrEmpty(post.User?.ProfilePicturePath))
                                    {
                                        <img src="@post.User.ProfilePicturePath"
                                             onerror="this.src='/images/default.jpg'"
                                             class="thread-author-avatar" />
                                    }
                                    <span class="thread-author-name">@post.User?.UserName</span>
                                </a>
                                <span class="thread-time">@post.CreatedOn.ToString("dd MMM yyyy")</span>
                                <span class="thread-meta-stat">
                                    <i class="fa-regular fa-comment fa-xs"></i>
                                    @commentCount
                                </span>
                            </div>
                        </div>

                        <!-- Reddit-style thumbnail -->
                        @if (!string.IsNullOrEmpty(firstImage))
                        {
                            <div class="thread-thumb">
                                <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id">
                                    <img src="@firstImage"
                                         onerror="this.style.display='none'"
                                         alt="@post.Title" />
                                </a>
                            </div>
                        }                      
                    </div>

                    <!-- Replies column -->
                    <div class="thread-replies">
                        <span class="thread-reply-count">@commentCount</span>
                        <span class="thread-reply-label">replies</span>
                    </div>

                </div>
            }
        </div>

        <!-- Infinite scroll sentinel -->
        <div id="scroll-sentinel"></div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ── Search ────────────────────────────────────────────────
            const searchInput = document.getElementById('thread-search');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const q = this.value.toLowerCase();
                    document.querySelectorAll('.thread-row').forEach(row => {
                        const title = row.querySelector('.thread-title')?.textContent.toLowerCase() ?? '';
                        const preview = row.querySelector('.thread-preview')?.textContent.toLowerCase() ?? '';
                        row.style.display = (title.includes(q) || preview.includes(q)) ? '' : 'none';
                    });
                });
            }

            // ── Subcat tabs ───────────────────────────────────────────
            document.querySelectorAll('.subcat-tab').forEach(tab => {
                tab.addEventListener('click', function () {
                    document.querySelectorAll('.subcat-tab').forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    const subcat = this.dataset.subcat;
                    document.querySelectorAll('.thread-row').forEach(row => {
                        row.style.display = (subcat === 'all' || row.dataset.subcat === subcat) ? '' : 'none';
                    });
                });
            });

            // ── Sort buttons ──────────────────────────────────────────
            document.querySelectorAll('.sort-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                });
            });

            // ── Feed vote buttons ─────────────────────────────────────
            document.querySelectorAll('.feed-vote-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const postId   = this.dataset.postId;
                    const isUpvote = this.dataset.isUpvote === 'true';
                    const token    = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                    try {
                        const response = await fetch(`/Posts/Vote/${postId}?isUpvote=${isUpvote}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token,
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                        });
                        if (response.ok) {
                            const data = await response.json();
                            const scoreEl = document.querySelector(`.feed-vote-score[data-post-id="${postId}"]`);
                            if (scoreEl) {
                                scoreEl.textContent = data.score;
                                scoreEl.className = 'vote-count feed-vote-score' +
                                    (data.score > 0 ? ' positive' : data.score < 0 ? ' negative' : '');
                            }
                        }
                    } catch (err) { console.error('Vote failed', err); }
                });
            });

        });
    </script>
}
