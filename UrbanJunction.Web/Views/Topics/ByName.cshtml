@model IEnumerable<UrbanJunction.Data.Models.Post>

@{
    ViewData["Title"] = ViewBag.TopicName;
    var userVotes  = ViewBag.UserVotes as Dictionary<int, string> ?? new Dictionary<int, string>();
    string topicName = ViewBag.TopicName ?? "";
    string topicClass = topicName.ToLower() switch
    {
        "art"     => "art",
        "music"   => "music",
        "fashion" => "fashion",
        _         => "default"
    };
    string topicColor = topicClass switch
    {
        "art"     => "#4caf72",
        "music"   => "#7c6fff",
        "fashion" => "#f0a04b",
        _         => "#e85d4a"
    };
}

<div class="forum-main">

    <!-- Topic header -->
    <div class="topic-header">
        <div class="topic-title">
            <span class="topic-title-dot" style="background:@topicColor;"></span>
            @topicName
            <span style="font-size:0.8rem;font-weight:400;color:var(--text-dim);font-family:var(--font-mono);">
                @Model.Count() threads
            </span>
        </div>
        <div class="topic-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="thread-search" placeholder="Search threads…" autocomplete="off" />
        </div>
    </div>

    <!-- Subcategory tabs -->
    <div class="subcat-tabs">
        <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="@ViewBag.ActiveSort"
           class="subcat-tab @(ViewBag.ActiveSubcat == "all" ? "active" : "")">All</a>

        @if (topicClass == "art")
        {
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="@ViewBag.ActiveSort" asp-route-subcat="Graffiti"
               class="subcat-tab @(ViewBag.ActiveSubcat == "Graffiti" ? "active" : "")">Graffiti</a>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="@ViewBag.ActiveSort" asp-route-subcat="Photography"
               class="subcat-tab @(ViewBag.ActiveSubcat == "Photography" ? "active" : "")">Photography</a>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="@ViewBag.ActiveSort" asp-route-subcat="Digital"
               class="subcat-tab @(ViewBag.ActiveSubcat == "Digital" ? "active" : "")">Digital Art</a>
        }
        else if (topicClass == "music")
        {
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="@ViewBag.ActiveSort" asp-route-subcat="HipHop"
               class="subcat-tab @(ViewBag.ActiveSubcat == "HipHop" ? "active" : "")">Hip-Hop</a>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="@ViewBag.ActiveSort" asp-route-subcat="Techno"
               class="subcat-tab @(ViewBag.ActiveSubcat == "Techno" ? "active" : "")">Techno</a>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="@ViewBag.ActiveSort" asp-route-subcat="Indie"
               class="subcat-tab @(ViewBag.ActiveSubcat == "Indie" ? "active" : "")">Indie</a>
        }
        else if (topicClass == "fashion")
        {
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="@ViewBag.ActiveSort" asp-route-subcat="Streetwear"
               class="subcat-tab @(ViewBag.ActiveSubcat == "Streetwear" ? "active" : "")">Streetwear</a>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="@ViewBag.ActiveSort" asp-route-subcat="Vintage"
               class="subcat-tab @(ViewBag.ActiveSubcat == "Vintage" ? "active" : "")">Vintage</a>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="@ViewBag.ActiveSort" asp-route-subcat="Designers"
               class="subcat-tab @(ViewBag.ActiveSubcat == "Designers" ? "active" : "")">Designers</a>
        }
    </div>

    <!-- Sort + New Thread bar -->
    <div class="feed-controls">
        <div class="feed-controls-left">
            <span style="font-size:0.75rem;color:var(--text-dim);font-family:var(--font-mono);margin-right:0.25rem;">Sort:</span>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="new"
               class="sort-btn @(ViewBag.ActiveSort == "new" ? "active" : "")">New</a>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="top"
               class="sort-btn @(ViewBag.ActiveSort == "top" ? "active" : "")">Top</a>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="@topicName" asp-route-sort="hot"
               class="sort-btn @(ViewBag.ActiveSort == "hot" ? "active" : "")">Hot</a>
        </div>
    </div>

    <!-- Thread list -->
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:4rem 0;color:var(--text-dim);">
            <i class="fa-regular fa-face-sad-tear fa-2x" style="display:block;margin-bottom:0.75rem;"></i>
            No threads yet. Be the first to post.
        </div>
    }
    else
    {
        <div class="thread-list" id="posts-container">
            @foreach (var post in Model)
            {
                var isOwner = User.Identity?.IsAuthenticated == true &&
                              User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == post.UserId;
                var isAdmin       = User.IsInRole("Admin");
                var subcatName    = post.Subcategory?.Name ?? "";
                var firstImage    = post.Images?.FirstOrDefault()?.ImagePath;
                var reactionCount = (post.Reactions?.Count(r => r.IsUpvote) ?? 0) - (post.Reactions?.Count(r => !r.IsUpvote) ?? 0);
                var commentCount  = post.Comments?.Count() ?? 0;
                var currentVote   = userVotes.GetValueOrDefault(post.Id, "");

                var preview = "";
                if (!string.IsNullOrEmpty(post.Content))
                {
                    preview = post.Content.Length > 120
                        ? post.Content.Substring(0, 120).TrimEnd() + "…"
                        : post.Content;
                }

                <div class="thread-row @(post.IsPinned ? "pinned" : "") @(post.IsLocked ? "locked" : "")"
                     data-subcat="@subcatName">

                    <!-- Vote strip -->
                    <div class="thread-vote">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button class="vote-btn upvote feed-vote-btn @(currentVote == "up" ? "vote-active-up" : "")"
                                    data-post-id="@post.Id" data-is-upvote="true"
                                    data-user-vote="@currentVote" title="Upvote">
                                <i class="fa-solid fa-chevron-up"></i>
                            </button>
                            <span class="vote-count feed-vote-score @(reactionCount > 0 ? "positive" : reactionCount < 0 ? "negative" : "")"
                                  data-post-id="@post.Id">
                                @reactionCount
                            </span>
                            <button class="vote-btn downvote feed-vote-btn @(currentVote == "down" ? "vote-active-down" : "")"
                                    data-post-id="@post.Id" data-is-upvote="false"
                                    data-user-vote="@currentVote" title="Downvote">
                                <i class="fa-solid fa-chevron-down"></i>
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="vote-btn upvote" title="Login to vote">
                                <i class="fa-solid fa-chevron-up"></i>
                            </a>
                            <span class="vote-count @(reactionCount > 0 ? "positive" : reactionCount < 0 ? "negative" : "")">
                                @reactionCount
                            </span>
                            <a asp-controller="Account" asp-action="Login" class="vote-btn downvote" title="Login to vote">
                                <i class="fa-solid fa-chevron-down"></i>
                            </a>
                        }
                    </div>

                    <!-- Thread content -->
                    <div class="thread-content">
                        <div class="thread-text">

                            <!-- Tags row -->
                            <div class="thread-tags">
                                <span class="thread-tag @topicClass">@topicName</span>
                                @if (post.IsPinned)
                                {
                                    <span class="thread-tag pinned"><i class="fa-solid fa-thumbtack fa-xs me-1"></i>Pinned</span>
                                }
                                @if (post.IsLocked)
                                {
                                    <span class="thread-tag locked"><i class="fa-solid fa-lock fa-xs me-1"></i>Locked</span>
                                }
                                @if (!string.IsNullOrEmpty(subcatName))
                                {
                                    <span class="thread-tag custom">@subcatName</span>
                                }
                                @if (isOwner || isAdmin)
                                {
                                    <div class="d-flex align-items-center gap-1 ms-auto">
                                        @if (isAdmin)
                                        {
                                            <form asp-action="TogglePin" asp-controller="Admin" asp-route-id="@post.Id"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" class="thread-tag custom"
                                                        style="border:none;cursor:pointer;
                                                               color:@(post.IsPinned ? "var(--accent)" : "var(--text-dim)");
                                                               background:@(post.IsPinned ? "rgba(232,93,74,0.08)" : "transparent");"
                                                        title="@(post.IsPinned ? "Unpin" : "Pin")">
                                                    <i class="fa-solid fa-thumbtack fa-xs"></i>
                                                </button>
                                            </form>
                                            <form asp-action="ToggleLock" asp-controller="Admin" asp-route-id="@post.Id"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" class="thread-tag custom"
                                                        style="border:none;cursor:pointer;
                                                               color:@(post.IsLocked ? "var(--fashion)" : "var(--text-dim)");
                                                               background:@(post.IsLocked ? "rgba(240,160,75,0.08)" : "transparent");"
                                                        title="@(post.IsLocked ? "Unlock" : "Lock")">
                                                    <i class="fa-solid fa-lock fa-xs"></i>
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="Delete" asp-controller="Posts" asp-route-id="@post.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="thread-tag custom"
                                                    style="border:none;cursor:pointer;color:var(--accent);background:rgba(232,93,74,0.08);"
                                                    onclick="return confirm('Delete this thread?')">
                                                <i class="fa-regular fa-trash-can fa-xs"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                            <!-- Title -->
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                               class="thread-title-link text-decoration-none">
                                @post.Title
                            </a>

                            <!-- Preview -->
                            @if (!string.IsNullOrEmpty(preview))
                            {
                                <div class="thread-preview">@preview</div>
                            }

                            <!-- Meta -->
                            <div class="thread-meta">
                                <a asp-controller="Account" asp-action="UserProfile"
                                   asp-route-username="@post.User?.UserName"
                                   class="thread-author text-decoration-none">
                                    @if (!string.IsNullOrEmpty(post.User?.ProfilePicturePath))
                                    {
                                        <img src="@post.User.ProfilePicturePath"
                                             onerror="this.src='/images/default.jpg'"
                                             class="thread-author-avatar" />
                                    }
                                    <span class="thread-author-name">@post.User?.UserName</span>
                                </a>
                                <span class="thread-time">@post.CreatedOn.ToString("dd MMM yyyy")</span>
                                <span class="thread-meta-stat">
                                    <i class="fa-regular fa-comment fa-xs"></i>
                                    @commentCount
                                </span>
                            </div>
                        </div>

                        <!-- Thumbnail -->
                        @if (!string.IsNullOrEmpty(firstImage))
                        {
                            <div class="thread-thumb">
                                <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id">
                                    <img src="@firstImage"
                                         onerror="this.style.display='none'"
                                         alt="@post.Title" />
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Replies column -->
                    <div class="thread-replies">
                        <span class="thread-reply-count">@commentCount</span>
                        <span class="thread-reply-label">replies</span>
                    </div>

                </div>
            }
        </div>

        <div id="scroll-sentinel"></div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ── Click-to-open thread rows ──────────────────────────────
            document.querySelectorAll('.thread-row').forEach(row => {
                row.style.cursor = 'pointer';
                row.addEventListener('click', function (e) {
                    if (e.target.closest('.thread-vote') ||
                        e.target.closest('a') ||
                        e.target.closest('button') ||
                        e.target.closest('form')) return;
                    const link = this.querySelector('.thread-title-link');
                    if (link) window.location.href = link.href;
                });
            });

            // ── Search ────────────────────────────────────────────────
            const searchInput = document.getElementById('thread-search');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const q = this.value.toLowerCase();
                    document.querySelectorAll('.thread-row').forEach(row => {
                        const title   = row.querySelector('.thread-title-link')?.textContent.toLowerCase() ?? '';
                        const preview = row.querySelector('.thread-preview')?.textContent.toLowerCase() ?? '';
                        row.style.display = (title.includes(q) || preview.includes(q)) ? '' : 'none';
                    });
                });
            }

            // ── Sort buttons ──────────────────────────────────────────
            document.querySelectorAll('.sort-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                });
            });

            // ── Feed vote buttons ─────────────────────────────────────
            document.querySelectorAll('.feed-vote-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const postId   = this.dataset.postId;
                    const isUpvote = this.dataset.isUpvote === 'true';
                    const token    = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                    try {
                        const response = await fetch(`/Posts/Vote/${postId}?isUpvote=${isUpvote}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token,
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                        });
                        if (response.ok) {
                            const data = await response.json();
                            const scoreEl = document.querySelector(`.feed-vote-score[data-post-id="${postId}"]`);
                            if (scoreEl) {
                                scoreEl.textContent = data.score;
                                scoreEl.className = 'vote-count feed-vote-score' +
                                    (data.score > 0 ? ' positive' : data.score < 0 ? ' negative' : '');
                            }
                            const upBtn   = document.querySelector(`.feed-vote-btn.upvote[data-post-id="${postId}"]`);
                            const downBtn = document.querySelector(`.feed-vote-btn.downvote[data-post-id="${postId}"]`);
                            if (upBtn && downBtn) {
                                upBtn.classList.toggle('vote-active-up',     data.userVote === 'up');
                                downBtn.classList.toggle('vote-active-down', data.userVote === 'down');
                            }
                        }
                    } catch (err) { console.error('Vote failed', err); }
                });
            });

        });
    </script>
}
