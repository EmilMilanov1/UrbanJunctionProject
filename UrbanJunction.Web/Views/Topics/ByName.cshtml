@model IEnumerable<UrbanJunction.Data.Models.Post>

@{
    ViewData["Title"] = ViewBag.TopicName;
    var likedPostIds = ViewBag.LikedPostIds as HashSet<int> ?? new HashSet<int>();
    string topicName = ViewBag.TopicName ?? "";
    string topicClass = topicName.ToLower() switch
    {
        "art" => "art",
        "music" => "music",
        "fashion" => "fashion",
        _ => "default"
    };
    string topicColor = topicClass switch
    {
        "art" => "#4caf72",
        "music" => "#6c63ff",
        "fashion" => "#f5a623",
        _ => "#e85d4a"
    };
}

<div style="max-width:740px;margin:0 auto;padding:32px 16px;">

    <!-- Header row -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 style="font-size:22px;font-weight:700;color:#e8e0d5;margin:0;">
                <span style="color:@topicColor;">@topicName</span> Posts
            </h2>
            <p style="color:#6b6358;font-size:13px;margin:4px 0 0;">@Model.Count() posts</p>
        </div>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <a asp-controller="Posts" asp-action="Create"
               class="btn btn-sm rounded-pill px-4"
               style="background:@topicColor;border:none;color:white;font-size:13px;">
                + New Post
            </a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Register"
               class="btn btn-outline-light btn-sm rounded-pill px-4">
                + New Post
            </a>
        }
    </div>

    <!-- Posts list -->
    @if (!Model.Any())
    {
        <div class="text-center py-5" style="color:#6b6358;">
            <i class="fa-regular fa-face-sad-tear fa-2x mb-3 d-block"></i>
            No posts in this topic yet. Be the first!
        </div>
    }
    else
    {
        <div id="posts-container">
            @foreach (var post in Model)
            {
                var isOwner = User.Identity?.IsAuthenticated == true &&
                User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == post.UserId;
                var isAdmin = User.IsInRole("Admin");
                var initials = post.User?.UserName?.Length >= 2
                ? post.User.UserName.Substring(0, 2).ToUpper()
                : (post.User?.UserName ?? "?").ToUpper();
                var subcatName = post.Subcategory?.Name ?? "";

                <div class="uj-post-card @topicClass">
                    <!-- Top row -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(post.User?.ProfilePicturePath))
                            {
                                <img src="@post.User.ProfilePicturePath"
                                     onerror="this.src='/images/default.jpg'"
                                     style="width:34px;height:34px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                            }
                            else
                            {
                                <div class="uj-avatar" style="background:linear-gradient(135deg,@topicColor,#111);">@initials</div>
                            }
                            <div>
                                <div style="font-size:13px;color:#d0c8be;font-weight:500;">@post.User?.UserName</div>
                                <div style="font-size:11px;color:#6b6358;">@post.CreatedOn.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(subcatName))
                        {
                            <span class="uj-tag @topicClass">@subcatName</span>
                        }
                    </div>

                    <!-- Title -->
                    <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                       class="text-decoration-none">
                        <h3 class="post-title">@post.Title</h3>
                    </a>

                    <!-- Image carousel -->
                    @if (post.Images != null && post.Images.Any())
                    {
                        string carouselId = $"carousel_{post.Id}";
                        <div id="@carouselId" class="carousel slide mb-3 rounded overflow-hidden"
                             data-bs-ride="carousel" style="max-height:300px;">
                            <div class="carousel-inner">
                                @for (int i = 0; i < post.Images.Count; i++)
                                {
                                    var image = post.Images.ElementAt(i);
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@image.ImagePath" class="d-block w-100"
                                             style="object-fit:cover;height:280px;" alt="Post Image">
                                    </div>
                                }
                            </div>
                            @if (post.Images.Count > 1)
                            {
                                <button class="carousel-control-prev" type="button"
                                        data-bs-target="#@carouselId" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon"></span>
                                </button>
                                <button class="carousel-control-next" type="button"
                                        data-bs-target="#@carouselId" data-bs-slide="next">
                                    <span class="carousel-control-next-icon"></span>
                                </button>
                            }
                        </div>
                    }

                    <!-- Action bar -->
                    <div class="post-actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-action="ToggleLike" asp-controller="Posts" asp-route-id="@post.Id"
                                  method="post" class="d-inline like-form">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="action-btn @(likedPostIds.Contains(post.Id) ? "liked" : "")">
                                    <i class="like-icon @(likedPostIds.Contains(post.Id) ? "fa-solid" : "fa-regular") fa-heart"></i>
                                    <span class="like-count">@post.Reactions.Count()</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="action-btn">
                                <i class="fa-regular fa-heart"></i>
                                <span>@post.Reactions.Count()</span>
                            </a>
                        }

                        <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                           class="action-btn">
                            <i class="fa-regular fa-comment"></i>
                            <span>@post.Comments.Count()</span>
                        </a>

                        <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                           class="action-btn ms-auto">
                            View Post <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                        </a>

                        @if (isOwner || isAdmin)
                        {
                            <form asp-action="Delete" asp-controller="Posts" asp-route-id="@post.Id"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="action-btn" style="color:#e85d4a;"
                                        onclick="return confirm('Delete this post?')">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // per topic tint
        document.querySelector('.navbar').style.setProperty('--topic-color', '@topicColor');
        document.querySelector('.navbar').classList.add('topic-tinted');

        const menuBtn = document.querySelector('.menu-btn');
        menuBtn.style.setProperty('border-color', '@topicColor', 'important');
        menuBtn.style.setProperty('color', '@topicColor', 'important');

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.like-form').forEach(form => {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const icon = this.querySelector('.like-icon');
                    const count = this.querySelector('.like-count');
                    const btn = this.querySelector('button');
                    const token = this.querySelector('input[name="__RequestVerificationToken"]').value;
                    try {
                        const response = await fetch(this.action, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token,
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                        });
                        if (response.ok) {
                            const data = await response.json();
                            count.textContent = data.count;
                            if (data.userLiked) {
                                icon.classList.replace('fa-regular', 'fa-solid');
                                btn.classList.add('liked');
                            } else {
                                icon.classList.replace('fa-solid', 'fa-regular');
                                btn.classList.remove('liked');
                            }
                        }
                    } catch (err) { console.error('Like failed', err); }
                });
            });
        });
    </script>
}