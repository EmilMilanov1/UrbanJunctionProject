@model IEnumerable<UrbanJunction.Data.Models.Post>

@{
    ViewData["Title"] = ViewBag.TopicName;
    var likedPostIds = ViewBag.LikedPostIds as HashSet<int> ?? new HashSet<int>();
}

<div class="d-flex justify-content-end mb-4">
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <a asp-controller="Posts" asp-action="Create" class="btn btn-info">+ New Post</a>
    }
    else
    {
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light">+ New Post</a>
    }
</div>

<div class="container mt-5">
    <h2 class="text-center mb-5 text-white display-6">@ViewBag.TopicName Posts</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm py-4">
            No posts available in this topic yet.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var post in Model)
            {
                var isOwner = User.Identity?.IsAuthenticated == true &&
                User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == post.UserId;
                var isAdmin = User.IsInRole("Admin");

                <div class="col">
                    <div class="card h-100 bg-dark text-light border-0 shadow-lg rounded-3 overflow-hidden">

                        @if (post.Images != null && post.Images.Any())
                        {
                            string carouselId = $"carousel_{post.Id}";
                            <div id="@carouselId" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    @for (int i = 0; i < post.Images.Count; i++)
                                    {
                                        var image = post.Images.ElementAt(i);
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <img src="@image.ImagePath" class="d-block w-100"
                                                 style="object-fit: cover; height: 220px;" alt="Post Image">
                                        </div>
                                    }
                                </div>
                                @if (post.Images.Count > 1)
                                {
                                    <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon"></span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                                        <span class="carousel-control-next-icon"></span>
                                    </button>
                                }
                            </div>
                        }

                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="card-title fw-bold text-info">@post.Title</h5>
                                <p class="card-text text-secondary">
                                    @(post.Content?.Length > 150 ? post.Content.Substring(0, 150) + "..." : post.Content)
                                </p>
                            </div>

                            <div class="mt-3">
                                <p class="card-text mb-2">
                                    <small class="text-muted">
                                        Posted by <strong>@post.User?.UserName</strong> on @post.CreatedOn.ToShortDateString()
                                    </small>
                                </p>

                                <div class="d-flex align-items-center gap-3 mt-2 mb-2">

                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <form asp-action="ToggleLike" asp-controller="Posts" asp-route-id="@post.Id"
                                              method="post" class="d-inline like-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-link p-0 text-decoration-none d-flex align-items-center gap-1">
                                                <i class="like-icon @(likedPostIds.Contains(post.Id) ? "fa-solid" : "fa-regular") fa-heart"
                                                   style="font-size: 1.1rem; color: @(likedPostIds.Contains(post.Id) ? "#e25555" : "#aaa");"></i>
                                                <span class="like-count" style="color: #aaa; font-size: 0.9rem;">@post.Reactions.Count()</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account" asp-action="Login"
                                           class="text-decoration-none d-flex align-items-center gap-1">
                                            <i class="fa-regular fa-heart" style="font-size: 1.1rem; color: #aaa;"></i>
                                            <span style="color: #aaa; font-size: 0.9rem;">@post.Reactions.Count()</span>
                                        </a>
                                    }

                                    <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                                       class="text-decoration-none d-flex align-items-center gap-1">
                                        <i class="fa-regular fa-comment" style="font-size: 1.1rem; color: #aaa;"></i>
                                        <span style="color: #aaa; font-size: 0.9rem;">@post.Comments.Count()</span>
                                    </a>

                                </div>

                                <div class="d-flex gap-2">
                                    @if (isOwner || isAdmin)
                                    {
                                        <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                                           class="btn btn-outline-info btn-sm flex-fill">
                                            View Post
                                        </a>
                                        <form asp-action="Delete" asp-controller="Posts" asp-route-id="@post.Id"
                                              method="post" class="flex-fill">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100"
                                                    onclick="return confirm('Delete this post?')">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                                           class="btn btn-outline-info btn-sm w-100">
                                            View Post
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.like-form').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                e.stopPropagation();

                const icon = this.querySelector('.like-icon');
                const count = this.querySelector('.like-count');
                const token = this.querySelector('input[name="__RequestVerificationToken"]').value;
                const url = this.action;

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                    });

                    if (response.ok) {
                        const data = await response.json();
                        count.textContent = data.count;
                        if (data.userLiked) {
                            icon.classList.remove('fa-regular');
                            icon.classList.add('fa-solid');
                            icon.style.color = '#e25555';
                        } else {
                            icon.classList.remove('fa-solid');
                            icon.classList.add('fa-regular');
                            icon.style.color = '#aaa';
                        }
                    }
                } catch (err) {
                    console.error('Like failed', err);
                }
            });
        });
    });
</script>