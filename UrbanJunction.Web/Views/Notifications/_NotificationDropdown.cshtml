@model IEnumerable<UrbanJunction.Data.Models.Notification>
@using UrbanJunction.Data.Models
@{
    int unreadCount = ViewBag.UnreadCount ?? 0;
}

<div id="notif-dropdown"
     style="width:320px;background:var(--bg-card);border:1px solid var(--border-light);
    border-radius:10px;overflow:hidden;
    box-shadow:0 16px 48px rgba(0,0,0,0.6);z-index:9999;">

    <div style="display:flex;align-items:center;justify-content:space-between;
        padding:12px 14px;border-bottom:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-family:var(--font-head);font-size:0.85rem;font-weight:700;
            color:var(--text);">Notifications</span>
            @if (unreadCount > 0)
            {
                <span id="notif-header-badge"
                      style="background:rgba(232,93,74,0.15);color:var(--accent);
                    font-family:var(--font-mono);font-size:0.65rem;
                    padding:2px 7px;border-radius:10px;font-weight:500;">
                    @unreadCount new
                </span>
            }
        </div>
        @if (unreadCount > 0)
        {
            <button onclick="notifMarkAllRead()"
                    style="background:none;border:none;cursor:pointer;
                font-size:0.72rem;color:var(--text-dim);
                font-family:var(--font-body);padding:0;transition:color 150ms;"
                    onmouseover="this.style.color='var(--text-muted)'"
                    onmouseout="this.style.color='var(--text-dim)'">
                Mark all read
            </button>
        }
    </div>

    <div style="max-height:340px;overflow-y:auto;" id="notif-list">
        @if (!Model.Any())
        {
            <div style="text-align:center;padding:2.5rem 1rem;color:var(--text-dim);">
                <i class="fa-regular fa-bell-slash fa-lg"
                   style="display:block;margin-bottom:0.5rem;opacity:0.4;"></i>
                <span style="font-size:0.8rem;">No notifications yet</span>
            </div>
        }
        else
        {
            foreach (var n in Model)
            {
                string icon, iconColor, iconBg, message;

                switch (n.Type)
                {
                    case NotificationType.Follow:
                        icon = "fa-user-plus";
                        iconColor = "#4caf72";
                        iconBg = "rgba(76,175,114,0.12)";
                        message = $"<strong>{n.Actor?.UserName ?? "Someone"}</strong> started following you";
                        break;
                    case NotificationType.Reaction:
                        icon = "fa-chevron-up";
                        iconColor = "#7c6fff";
                        iconBg = "rgba(124,111,255,0.12)";
                        message = $"<strong>{n.Actor?.UserName ?? "Someone"}</strong> upvoted your post"
                            + (n.Post != null ? $" <span style='color:var(--text-dim);'>&#8220;{(n.Post.Title.Length > 35 ? n.Post.Title.Substring(0, 35) + "…" : n.Post.Title)}&#8221;</span>" : "");
                        break;
                    case NotificationType.Comment:
                        icon = "fa-comment";
                        iconColor = "#f0a04b";
                        iconBg = "rgba(240,160,75,0.12)";
                        message = $"<strong>{n.Actor?.UserName ?? "Someone"}</strong> commented on your post"
                            + (n.Post != null ? $" <span style='color:var(--text-dim);'>&#8220;{(n.Post.Title.Length > 30 ? n.Post.Title.Substring(0, 30) + "…" : n.Post.Title)}&#8221;</span>" : "");
                        break;
                    case NotificationType.Reply:
                        icon = "fa-reply";
                        iconColor = "#f0a04b";
                        iconBg = "rgba(240,160,75,0.12)";
                        message = $"<strong>{n.Actor?.UserName ?? "Someone"}</strong> replied to your comment"
                            + (n.Post != null ? $" on <span style='color:var(--text-dim);'>&#8220;{(n.Post.Title.Length > 28 ? n.Post.Title.Substring(0, 28) + "…" : n.Post.Title)}&#8221;</span>" : "");
                        break;
                    case NotificationType.AdminReply:
                        icon = "fa-headset";
                        iconColor = "#e85d4a";
                        iconBg = "rgba(232,93,74,0.12)";
                        message = "<strong style='color:var(--accent);'>Admin</strong> replied to your support message"
                            + (n.ContactMessage != null ? $" <span style='color:var(--text-dim);'>&#8220;{(n.ContactMessage.Subject.Length > 28 ? n.ContactMessage.Subject.Substring(0, 28) + "…" : n.ContactMessage.Subject)}&#8221;</span>" : "");
                        break;
                    default:
                        icon = "fa-bell";
                        iconColor = "var(--text-dim)";
                        iconBg = "var(--bg-hover)";
                        message = "New notification";
                        break;
                }

                string? linkHref = n.Type switch
                {
                    NotificationType.Follow => n.Actor != null ? $"/u/{n.Actor.UserName}" : null,
                    NotificationType.Reaction => n.PostId.HasValue ? $"/Posts/Details/{n.PostId}" : null,
                    NotificationType.Comment => n.PostId.HasValue ? $"/Posts/Details/{n.PostId}" : null,
                    NotificationType.Reply => n.PostId.HasValue ? $"/Posts/Details/{n.PostId}#comment-{n.CommentId}" : null,
                    NotificationType.AdminReply => "/QA/Index",
                    _ => null
                };

                var ago = DateTime.UtcNow - n.CreatedOn;
                string agoText = ago.TotalMinutes < 1 ? "just now"
                    : ago.TotalMinutes < 60 ? $"{(int)ago.TotalMinutes}m ago"
                    : ago.TotalHours < 24 ? $"{(int)ago.TotalHours}h ago"
                    : ago.TotalDays < 7 ? $"{(int)ago.TotalDays}d ago"
                    : n.CreatedOn.ToString("dd MMM");

                string rowBg = !n.IsRead ? "background:rgba(232,93,74,0.045);" : "";
                string opacity = n.IsRead ? "opacity:0.55;" : "";

                <div class="notif-row @(!n.IsRead ? "notif-unread" : "")"
                     data-id="@n.Id"
                     style="display:flex;align-items:flex-start;gap:10px;
                    padding:10px 14px;border-bottom:1px solid var(--border);
                    cursor:pointer;transition:background 100ms;@rowBg@opacity"
                     onclick="notifRowClick(this, @n.Id, '@linkHref')"
                     onmouseover="this.style.background='var(--bg-hover)'"
                     onmouseout="notifRestoreHover(this)">

                    <div style="width:32px;height:32px;border-radius:50%;
                        background:@iconBg;flex-shrink:0;
                        display:flex;align-items:center;justify-content:center;">
                        <i class="fa-solid @icon" style="color:@iconColor;font-size:12px;"></i>
                    </div>

                    <div style="flex:1;min-width:0;">
                        <p style="margin:0 0 3px;font-size:0.78rem;
                            color:var(--text-muted);line-height:1.45;">
                            @Html.Raw(message)
                        </p>
                        <span style="font-family:var(--font-mono);font-size:0.65rem;
                        color:var(--text-dim);">@agoText</span>
                    </div>

                    @if (!n.IsRead)
                    {
                        <div class="notif-dot"
                             style="width:6px;height:6px;border-radius:50%;
                        background:var(--accent);flex-shrink:0;
                        margin-top:5px;"></div>
                    }
                </div>
            }
        }
    </div>

    <div style="padding:9px 14px;border-top:1px solid var(--border);text-align:center;">
        <a asp-controller="QA" asp-action="Index"
               style="font-family:var(--font-mono);font-size:0.65rem;
            color:var(--text-dim);text-decoration:none;transition:color 150ms;"
               onmouseover="this.style.color='var(--text-muted)'"
               onmouseout="this.style.color='var(--text-dim)'">
            View all
        </a>
    </div>
</div>