@{
    ViewData["Title"] = "404 — Page Not Found";
    Layout = "_Layout";
}

<div style="display:flex;flex-direction:column;align-items:center;
            justify-content:center;min-height:60vh;text-align:center;gap:1rem;">
    <div style="font-family:var(--font-head);font-size:6rem;font-weight:800;
                color:var(--accent);line-height:1;">404</div>
    <div style="font-family:var(--font-head);font-size:1.5rem;color:var(--text);">
        Page not found
    </div>
    <div style="font-size:0.85rem;color:var(--text-dim);max-width:340px;">
        The page you are looking for doesn't exist or has been moved.
    </div>
    <a asp-controller="Home" asp-action="Index"
       style="margin-top:1rem;font-family:var(--font-mono);font-size:0.78rem;
              color:var(--accent);text-decoration:none;border:1px solid rgba(232,93,74,0.3);
              padding:0.5rem 1.25rem;border-radius:6px;transition:all 150ms;"
       onmouseover="this.style.background='rgba(232,93,74,0.1)'"
       onmouseout="this.style.background='transparent'">
        ← Back to home
    </a>
</div>