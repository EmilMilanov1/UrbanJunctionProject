@using Microsoft.AspNetCore.Identity
@using UrbanJunction.Data.Models
@inject UserManager<UrbanUser> UserManager
@inject INotificationService NotificationService

@{
    var currentUser = await UserManager.GetUserAsync(User);
    string profilePic = currentUser?.ProfilePicturePath ?? "/images/default.jpg";
    string username = User.Identity?.Name ?? "";

    var routeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var routeAction    = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var routeTopic     = ViewContext.RouteData.Values["name"]?.ToString() ?? ViewBag.TopicName as string ?? "";
    bool isArt     = routeTopic?.Equals("Art",     StringComparison.OrdinalIgnoreCase) ?? false;
    bool isMusic   = routeTopic?.Equals("Music",   StringComparison.OrdinalIgnoreCase) ?? false;
    bool isFashion = routeTopic?.Equals("Fashion", StringComparison.OrdinalIgnoreCase) ?? false;
    bool isTopicPage = isArt || isMusic || isFashion;

    string topicColor = isArt ? "var(--art)" : isMusic ? "var(--music)" : "var(--fashion)";
    string topicIcon  = isArt ? "fa-palette"  : isMusic ? "fa-music"    : "fa-shirt";
    string topicDesc  = isArt
        ? "Share your work, discover artists, and talk about the culture of visual art — graffiti, photography, digital, and more."
        : isMusic
        ? "Deep dives into genres, scenes, and sounds. From underground techno to bedroom pop — all music lives here."
        : "Streetwear, vintage, high fashion, and everything in between. Style is the message.";

    int notifUnreadCount = 0;
    if (User.Identity?.IsAuthenticated == true && currentUser != null)
    {
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " — Urban Junction" : "Urban Junction")</title>
    <link rel="icon" type="image/x-icon" href="~/images/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UrbanJunction.Web.styles.css" asp-append-version="true" />

    <style>
        .navbar {
        height: 48px !important;
        min-height: 48px !important;
        padding: 0 1.25rem !important;
        }
        .search-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9998;
            background: rgba(0,0,0,0.7);
            align-items: flex-start;
            justify-content: center;
            padding-top: 80px;
        }
        .search-overlay.open { display: flex; }
        .search-overlay-box {
            width: 100%;
            max-width: 600px;
            margin: 0 1rem;
            animation: search-drop 180ms cubic-bezier(0.16,1,0.3,1) forwards;
        }
        @@keyframes search-drop {
            from { opacity: 0; transform: translateY(-12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .search-overlay-inner {
            background: var(--bg-card);
            border: 1px solid var(--border-light);
            border-radius: 10px;
            overflow: hidden;
        }
        .search-overlay-bar {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.85rem 1.1rem;
            border-bottom: 1px solid var(--border);
        }
        .search-overlay-bar input {
            background: none;
            border: none;
            outline: none;
            color: var(--text);
            font-size: 1rem;
            font-family: var(--font-body);
            flex: 1;
        }
        .search-overlay-bar input::placeholder { color: var(--text-dim); }
        .search-overlay-hint {
            padding: 0.6rem 1.1rem;
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--text-dim);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .search-overlay-hint kbd {
            background: var(--bg-hover);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 0.1rem 0.4rem;
            font-family: var(--font-mono);
            font-size: 0.62rem;
            color: var(--text-dim);
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Search overlay -->
    <div class="search-overlay" id="searchOverlay" onclick="closeSearch(event)">
        <div class="search-overlay-box">
            <div class="search-overlay-inner">
                <form asp-controller="Search" asp-action="Index" method="get" id="searchOverlayForm">
                    <div class="search-overlay-bar">
                        <i class="fa-solid fa-magnifying-glass" style="color:var(--text-dim);font-size:0.9rem;flex-shrink:0;"></i>
                        <input type="text" name="query" id="searchOverlayInput"
                               placeholder="Search Urban Junction…"
                               autocomplete="off" />
                        <button type="button"
                                onclick="document.getElementById('searchOverlayInput').value='';document.getElementById('searchLiveResults').innerHTML='';document.getElementById('searchLiveResults').style.display='none';document.getElementById('searchOverlayInput').focus();"
                                id="searchClearBtn"
                                style="display:none;background:none;border:none;cursor:pointer;
                                       color:var(--text-dim);padding:0 4px;font-size:0.85rem;
                                       transition:color 150ms;"
                                onmouseover="this.style.color='var(--text-muted)'"
                                onmouseout="this.style.color='var(--text-dim)'">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </form>

                <!-- Live results -->
                <div id="searchLiveResults" style="display:none;border-top:1px solid var(--border);"></div>

                <div class="search-overlay-hint" id="searchHint">
                    <span>Search across Art, Music and Fashion</span>
                    <span><kbd>Esc</kbd> to close &nbsp;·&nbsp; <kbd>Ctrl K</kbd> to open</span>
                </div>
            </div>
        </div>
    </div>

    <!-- NAVBAR -->
    <header>
<nav class="navbar" style="display:flex;align-items:center;gap:1rem;">
        <!-- Brand -->
        <a asp-controller="Home" asp-action="Index" class="navbar-brand" style="flex-shrink:0;">
            <img src="~/images/logo.png" alt="Urban Junction" class="nav-logo-emblem" />
            <span class="navbar-brand-name">Urban Junction</span>
        </a>

        <!-- Search pill (center) -->
        <button onclick="openSearch()" type="button"
        style="display:inline-flex;align-items:center;gap:0.6rem;
               background:rgba(232,93,74,0.12);border:1px solid rgba(232,93,74,0.25);
               border-radius:999px;padding:0.4rem 1.25rem;cursor:pointer;
               transition:all 150ms;
               position:absolute;left:50%;transform:translateX(-50%);
               width:340px;"
        onmouseover="this.style.background='rgba(232,93,74,0.18)';this.style.borderColor='rgba(232,93,74,0.45)'"
        onmouseout="this.style.background='rgba(232,93,74,0.12)';this.style.borderColor='rgba(232,93,74,0.25)'">
            <i class="fa-solid fa-magnifying-glass" style="color:#e85d4a;font-size:0.8rem;flex-shrink:0;"></i>
            <span style="font-size:0.82rem;color:#a06060;font-family:var(--font-body);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                Search Urban Junction…
            </span>
            <span style="margin-left:auto;font-family:var(--font-mono);font-size:0.6rem;
                         color:#7a4a42;border:1px solid rgba(232,93,74,0.2);
                         border-radius:4px;padding:0.1rem 0.35rem;flex-shrink:0;">
                Ctrl K
            </span>
        </button>

        <!-- Right actions -->
        <div class="navbar-actions" style="flex-shrink:0;">
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <partial name="_NotificationBell" />

                <a asp-controller="Account" asp-action="Profile"
                   class="d-flex align-items-center gap-2 text-decoration-none">
                    <img src="@profilePic"
                         onerror="this.src='/images/default.jpg'"
                         class="navbar-avatar"
                         alt="@username" />
                    <span class="d-none d-lg-inline" style="font-size:0.82rem;color:var(--text-muted);">@username</span>
                </a>


                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="navbar-icon-btn" title="Logout">
                        <i class="fa-solid fa-right-from-bracket fa-sm"></i>
                    </button>
                </form>
            }
            else
            {
               <a asp-controller="Account" asp-action="Login" class="btn-new-thread"
                   style="background:rgba(232,93,74,0.12);border:1px solid rgba(232,93,74,0.25);
                          color:#a06060;"
                   onmouseover="this.style.background='rgba(232,93,74,0.18)';this.style.borderColor='rgba(232,93,74,0.45)'"
                   onmouseout="this.style.background='rgba(232,93,74,0.12)';this.style.borderColor='rgba(232,93,74,0.25)'">
                    <i class="fa-solid fa-right-to-bracket fa-xs"></i>
                    <span>Login</span>
                </a>
            }

            <button class="navbar-icon-btn d-md-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mobileMenu"
                    aria-label="Menu">
                <i class="fa-solid fa-bars fa-sm"></i>
            </button>
        </div>

    </nav>
</header>

    <!-- 3-COLUMN LAYOUT -->
    <div class="forum-layout">

        <!-- LEFT SIDEBAR -->
        <aside class="sidebar-left d-none d-lg-flex">

            <div class="sidebar-logo-block">
                <img src="~/images/logo.png" alt="Urban Junction" class="sidebar-logo-emblem" />
                <div class="sidebar-logo-name">Urban Junction</div>
                <div class="sidebar-logo-label">Forum</div>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-section-label">Topics</div>

                <a asp-controller="Topics" asp-action="ByName" asp-route-name="Art"
                   class="sidebar-nav-item @(isArt ? "active" : "")">
                    <span class="sidebar-topic-dot art"></span>
                    Art
                    <span class="sidebar-count">@(ViewBag.ArtCount ?? "")</span>
                </a>
                @if (isArt)
                {
                    <div class="sidebar-subcats">
                        <a asp-controller="Topics" asp-action="ByName" asp-route-name="Art" asp-route-subcat="Graffiti"
                           class="sidebar-subcat-item @(ViewBag.ActiveSubcat == "Graffiti" ? "active" : "")">Graffiti</a>
                        <a asp-controller="Topics" asp-action="ByName" asp-route-name="Art" asp-route-subcat="Photography"
                           class="sidebar-subcat-item @(ViewBag.ActiveSubcat == "Photography" ? "active" : "")">Photography</a>
                        <a asp-controller="Topics" asp-action="ByName" asp-route-name="Art" asp-route-subcat="Digital"
                           class="sidebar-subcat-item @(ViewBag.ActiveSubcat == "Digital" ? "active" : "")">Digital Art</a>
                    </div>
                }

                <a asp-controller="Topics" asp-action="ByName" asp-route-name="Music"
                   class="sidebar-nav-item @(isMusic ? "active" : "")">
                    <span class="sidebar-topic-dot music"></span>
                    Music
                    <span class="sidebar-count">@(ViewBag.MusicCount ?? "")</span>
                </a>
                @if (isMusic)
                {
                    <div class="sidebar-subcats">
                        <a asp-controller="Topics" asp-action="ByName" asp-route-name="Music" asp-route-subcat="HipHop"
                           class="sidebar-subcat-item @(ViewBag.ActiveSubcat == "HipHop" ? "active" : "")">Hip-Hop</a>
                        <a asp-controller="Topics" asp-action="ByName" asp-route-name="Music" asp-route-subcat="Electronic"
                           class="sidebar-subcat-item @(ViewBag.ActiveSubcat == "Electronic" ? "active" : "")">Electronic</a>
                        <a asp-controller="Topics" asp-action="ByName" asp-route-name="Music" asp-route-subcat="Indie"
                           class="sidebar-subcat-item @(ViewBag.ActiveSubcat == "Indie" ? "active" : "")">Indie</a>
                    </div>
                }

                <a asp-controller="Topics" asp-action="ByName" asp-route-name="Fashion"
                   class="sidebar-nav-item @(isFashion ? "active" : "")">
                    <span class="sidebar-topic-dot fashion"></span>
                    Fashion
                    <span class="sidebar-count">@(ViewBag.FashionCount ?? "")</span>
                </a>
                @if (isFashion)
                {
                    <div class="sidebar-subcats">
                        <a asp-controller="Topics" asp-action="ByName" asp-route-name="Fashion" asp-route-subcat="Streetwear"
                           class="sidebar-subcat-item @(ViewBag.ActiveSubcat == "Streetwear" ? "active" : "")">Streetwear</a>
                        <a asp-controller="Topics" asp-action="ByName" asp-route-name="Fashion" asp-route-subcat="Vintage"
                           class="sidebar-subcat-item @(ViewBag.ActiveSubcat == "Vintage" ? "active" : "")">Vintage</a>
                        <a asp-controller="Topics" asp-action="ByName" asp-route-name="Fashion" asp-route-subcat="Designers"
                           class="sidebar-subcat-item @(ViewBag.ActiveSubcat == "Designers" ? "active" : "")">Designers</a>
                    </div>
                }
            </div>

            <div class="sidebar-divider"></div>

            <div class="sidebar-section">
                <div class="sidebar-section-label">Sections</div>

                <a asp-controller="QA" asp-action="Index"
                   class="sidebar-nav-item @(routeController == "QA" ? "active" : "")">
                    <i class="fa-solid fa-circle-question fa-xs" style="color:var(--text-dim);width:14px;text-align:center;"></i>
                    Contact us
                </a>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="Posts" asp-action="MyPosts"
                       class="sidebar-nav-item @(routeController == "Posts" && routeAction == "MyPosts" ? "active" : "")">
                        <i class="fa-solid fa-pen-to-square fa-xs" style="color:var(--text-dim);width:14px;text-align:center;"></i>
                        My Posts
                    </a>
                    <a asp-controller="Account" asp-action="Profile"
                       class="sidebar-nav-item @(routeController == "Account" && routeAction == "Profile" ? "active" : "")">
                        <i class="fa-solid fa-user fa-xs" style="color:var(--text-dim);width:14px;text-align:center;"></i>
                        My Profile
                    </a>
                }
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="sidebar-divider"></div>
                <div class="sidebar-section">
                    <div class="sidebar-section-label">Admin</div>
                    <a asp-controller="Admin" asp-action="Index"
                       class="sidebar-nav-item @(routeController == "Admin" ? "active" : "")">
                        <i class="fa-solid fa-shield fa-xs" style="color:var(--text-dim);width:14px;text-align:center;"></i>
                        Admin Panel
                    </a>
                </div>
            }

        </aside>

        <!-- MAIN CONTENT -->
        <main role="main" class="pb-5" style="min-width:0;">
            @RenderBody()
        </main>

        <!-- RIGHT SIDEBAR -->
        <aside class="sidebar-right d-none d-xl-flex">
            @if (IsSectionDefined("RightSidebar"))
            {
                @await RenderSectionAsync("RightSidebar", required: false)
            }
            else if (isTopicPage)
            {
                <div class="widget">
                    <div class="widget-title" style="border-color:@topicColor;color:@topicColor;">
                        <i class="fa-solid @topicIcon fa-xs me-1"></i>
                        About @routeTopic
                    </div>
                    <p class="widget-desc">@topicDesc</p>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-controller="Posts" asp-action="Create"
                           asp-route-topicName="@routeTopic"
                           class="widget-cta-btn" style="--btn-color:@topicColor;">
                            <i class="fa-solid fa-plus fa-xs me-1"></i>New Thread
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           class="widget-cta-btn" style="--btn-color:@topicColor;">
                            <i class="fa-solid fa-right-to-bracket fa-xs me-1"></i>Login to Post
                        </a>
                    }
                </div>

                <div class="widget">
                    <div class="widget-title">Forum Stats</div>
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-value">@(ViewBag.TotalThreads ?? "—")</div>
                            <div class="stat-label">Threads</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-value">@(ViewBag.TotalReplies ?? "—")</div>
                            <div class="stat-label">Replies</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-value">@(ViewBag.TotalMembers ?? "—")</div>
                            <div class="stat-label">Members</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-value" style="color:var(--art);">@(ViewBag.OnlineCount ?? "—")</div>
                            <div class="stat-label">Online</div>
                        </div>
                    </div>
                </div>

                @if (ViewBag.TrendingPosts != null)
                {
                    <div class="widget">
                        <div class="widget-title">Trending This Week</div>
                        <div class="trending-list">
                            @{ int rank = 1; }
                            @foreach (var post in ViewBag.TrendingPosts)
                            {
                                <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                                   class="trending-item text-decoration-none">
                                    <span class="trending-rank @(rank == 1 ? "top" : "")">@rank</span>
                                    <span class="trending-title">@post.Title</span>
                                    <span class="trending-replies" style="color:@(post.Score > 0 ? "var(--art)" : post.Score < 0 ? "var(--accent)" : "var(--text-dim)");">
                                        @(post.Score > 0 ? "+" : "")@post.Score
                                    </span>
                                </a>
                                rank++;
                            }
                        </div>
                    </div>
                }

                @if (ViewBag.ActiveMembers != null)
                {
                    <div class="widget">
                        <div class="widget-title">Active Members</div>
                        <div class="members-list">
                            @foreach (var member in ViewBag.ActiveMembers)
                            {
                                <a asp-controller="Account" asp-action="Profile" asp-route-username="@member.UserName"
                                   class="member-item text-decoration-none">
                                    <div class="member-avatar-wrap">
                                        <img src="@(member.ProfilePicturePath ?? "/images/default.jpg")"
                                             onerror="this.src='/images/default.jpg'"
                                             class="member-avatar" alt="@member.UserName" />
                                        @if (member.IsOnline)
                                        {
                                            <span class="member-online-dot"></span>
                                        }
                                    </div>
                                    <span class="member-name">@member.UserName</span>
                                    <span class="member-posts">@member.PostCount</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                <div class="widget">
                    <div class="widget-title">Community Rules</div>
                    <ol class="widget-rules">
                        <li>Be real. No spam, no bots.</li>
                        <li>Respect the culture and each other.</li>
                        <li>Stay on topic per subcategory.</li>
                        <li>No self-promo without contributing.</li>
                        <li>Tag NSFW content appropriately.</li>
                    </ol>
                </div>
            }
        </aside>

    </div>

    <!-- MOBILE OFFCANVAS -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
        <div class="offcanvas-header">
            <div class="d-flex align-items-center gap-2">
                <img src="~/images/logo.png" alt="Urban Junction" style="height:28px;width:auto;" />
                <span class="offcanvas-title" id="mobileMenuLabel">Urban Junction</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">

            <div class="sidebar-section-label mb-2">Topics</div>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="Art" class="sidebar-nav-item mb-1">
                <span class="sidebar-topic-dot art"></span> Art
            </a>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="Music" class="sidebar-nav-item mb-1">
                <span class="sidebar-topic-dot music"></span> Music
            </a>
            <a asp-controller="Topics" asp-action="ByName" asp-route-name="Fashion" class="sidebar-nav-item mb-1">
                <span class="sidebar-topic-dot fashion"></span> Fashion
            </a>

            <div class="sidebar-divider"></div>

            <div class="sidebar-section-label mb-2">Sections</div>
            <a asp-controller="QA" asp-action="Index" class="sidebar-nav-item mb-1">
                <i class="fa-solid fa-circle-question fa-xs me-2"></i>Contact us
            </a>
            <a asp-controller="Search" asp-action="Index" class="sidebar-nav-item mb-1">
                <i class="fa-solid fa-magnifying-glass fa-xs me-2"></i>Search
            </a>

            <div class="sidebar-divider"></div>

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a asp-controller="Account" asp-action="Profile" class="sidebar-nav-item mb-1">
                    <i class="fa-solid fa-user fa-xs me-2"></i>My Profile
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Index" class="sidebar-nav-item mb-1" style="color:var(--fashion);">
                        <i class="fa-solid fa-shield fa-xs me-2"></i>Admin Panel
                    </a>
                }
                <div class="sidebar-divider"></div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-nav-item w-100 text-start" style="color:var(--accent);">
                        <i class="fa-solid fa-right-from-bracket fa-xs me-2"></i>Logout
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-new-thread d-flex justify-content-center mt-2">
                    <i class="fa-solid fa-right-to-bracket fa-xs me-2"></i>Login
                </a>
            }

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

   <script>
        function openSearch() {
            document.getElementById('searchOverlay').classList.add('open');
            setTimeout(() => document.getElementById('searchOverlayInput').focus(), 50);
        }

        function closeSearch(e) {
            if (e.target === document.getElementById('searchOverlay')) {
                document.getElementById('searchOverlay').classList.remove('open');
                document.getElementById('searchLiveResults').innerHTML = '';
                document.getElementById('searchLiveResults').style.display = 'none';
                document.getElementById('searchOverlayInput').value = '';
                document.getElementById('searchClearBtn').style.display = 'none';
                document.getElementById('searchHint').style.display = 'flex';
            }
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                document.getElementById('searchOverlay').classList.remove('open');
                document.getElementById('searchLiveResults').innerHTML = '';
                document.getElementById('searchLiveResults').style.display = 'none';
                document.getElementById('searchOverlayInput').value = '';
                document.getElementById('searchClearBtn').style.display = 'none';
                document.getElementById('searchHint').style.display = 'flex';
            }
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                openSearch();
            }
        });

        (function () {
            let searchTimer = null;
            let lastQuery = '';

            const input    = document.getElementById('searchOverlayInput');
            const results  = document.getElementById('searchLiveResults');
            const hint     = document.getElementById('searchHint');
            const clearBtn = document.getElementById('searchClearBtn');
            const form     = document.getElementById('searchOverlayForm');

            if (!input) return;

            input.addEventListener('input', function () {
                const q = this.value.trim();

                clearBtn.style.display = q.length > 0 ? 'block' : 'none';

                if (q.length === 0) {
                    results.style.display = 'none';
                    results.innerHTML = '';
                    hint.style.display = 'flex';
                    lastQuery = '';
                    return;
                }

                if (q === lastQuery) return;
                lastQuery = q;

                clearTimeout(searchTimer);
                searchTimer = setTimeout(() => fetchResults(q), 220);
            });

            // Enter key submits the full search page
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    form.submit();
                }
                // Arrow key navigation
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    const items = results.querySelectorAll('.search-live-item');
                    if (items.length) items[0].focus();
                }
            });

            async function fetchResults(q) {
                hint.style.display = 'none';
                results.style.display = 'block';
                results.innerHTML = `
                    <div style="padding:1rem 1.1rem;display:flex;align-items:center;gap:0.5rem;
                                color:var(--text-dim);font-size:0.82rem;">
                        <i class="fa-solid fa-circle-notch fa-spin fa-xs"></i> Searching…
                    </div>`;

                try {
                    const resp = await fetch(`/Search/Live?query=${encodeURIComponent(q)}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const data = await resp.json();
                    renderResults(data, q);
                } catch {
                    results.innerHTML = `<div style="padding:1rem 1.1rem;color:var(--text-dim);font-size:0.82rem;">Something went wrong.</div>`;
                }
            }

            function renderResults(data, q) {
                if (!data || data.length === 0) {
                    results.innerHTML = `
                        <div style="padding:1.25rem 1.1rem;text-align:center;color:var(--text-dim);font-size:0.82rem;">
                            <i class="fa-regular fa-face-sad-tear fa-sm" style="display:block;margin-bottom:0.4rem;opacity:0.4;"></i>
                            No results for "<strong style="color:var(--text-muted);">${escHtml(q)}</strong>"
                        </div>`;
                    return;
                }

                const colorMap = { art: '#4caf72', music: '#7c6fff', fashion: '#f0a04b' };

                let html = '';
                data.forEach((post, i) => {
                    const tc = (post.topicName || '').toLowerCase();
                    const color = colorMap[tc] || '#e85d4a';
                    const preview = post.preview ? `<span style="color:var(--text-dim);font-size:0.75rem;margin-left:0.5rem;">${escHtml(post.preview)}</span>` : '';
                    html += `
                        <a href="/Posts/Details/${post.id}"
                           class="search-live-item"
                           tabindex="0"
                           style="display:flex;align-items:center;gap:0.75rem;
                                  padding:0.7rem 1.1rem;text-decoration:none;
                                  border-bottom:1px solid var(--border);
                                  transition:background 100ms;outline:none;"
                           onmouseover="this.style.background='var(--bg-hover)'"
                           onmouseout="this.style.background='transparent'"
                           onfocus="this.style.background='var(--bg-hover)'"
                           onblur="this.style.background='transparent'"
                           onkeydown="searchItemKeydown(event, ${i})">
                            <div style="width:28px;height:28px;border-radius:6px;flex-shrink:0;
                                        background:${color}18;display:flex;align-items:center;
                                        justify-content:center;">
                                <i class="fa-solid fa-file-lines fa-xs" style="color:${color};font-size:11px;"></i>
                            </div>
                            <div style="flex:1;min-width:0;overflow:hidden;">
                                <div style="font-size:0.85rem;font-weight:500;color:var(--text);
                                            white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    ${highlightMatch(escHtml(post.title), escHtml(q))}
                                </div>
                                <div style="display:flex;align-items:center;gap:0.4rem;margin-top:1px;">
                                    <span style="font-family:var(--font-mono);font-size:0.62rem;
                                                 color:${color};text-transform:uppercase;
                                                 letter-spacing:0.05em;">${escHtml(post.topicName)}</span>
                                    ${preview}
                                </div>
                            </div>
                            <i class="fa-solid fa-arrow-right fa-xs" style="color:var(--text-dim);font-size:10px;flex-shrink:0;"></i>
                        </a>`;
                });

                // "See all results" footer
                html += `
                    <a href="/Search/Index?query=${encodeURIComponent(q)}"
                       style="display:flex;align-items:center;justify-content:center;gap:0.5rem;
                              padding:0.7rem;font-family:var(--font-mono);font-size:0.68rem;
                              color:var(--accent);text-decoration:none;transition:background 100ms;"
                       onmouseover="this.style.background='var(--bg-hover)'"
                       onmouseout="this.style.background='transparent'">
                        See all results for "<strong>${escHtml(q)}</strong>"
                        <i class="fa-solid fa-arrow-right fa-xs"></i>
                    </a>`;

                results.innerHTML = html;
            }

            function highlightMatch(text, q) {
                try {
                    const re = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
                    return text.replace(re, `<mark style="background:rgba(232,93,74,0.25);color:var(--text);border-radius:2px;padding:0 1px;">$1</mark>`);
                } catch { return text; }
            }

            function escHtml(str) {
                return String(str ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            window.searchItemKeydown = function (e, idx) {
                const items = results.querySelectorAll('.search-live-item');
                if (e.key === 'ArrowDown') { e.preventDefault(); if (items[idx + 1]) items[idx + 1].focus(); }
                if (e.key === 'ArrowUp')   { e.preventDefault(); if (idx === 0) input.focus(); else if (items[idx - 1]) items[idx - 1].focus(); }
            };
        })();
    </script>

    <script>
    (function () {
        let notifOpen = false;

        window.toggleNotifDropdown = async function (e) {
            e.stopPropagation();
            const anchor = document.getElementById('notif-dropdown-anchor');
            if (!anchor) return;

            if (notifOpen) {
                anchor.style.display = 'none';
                notifOpen = false;
                return;
            }

            anchor.style.display = 'block';
            notifOpen = true;
            anchor.innerHTML = '<div style="padding:1.5rem;text-align:center;color:var(--text-dim);font-size:0.8rem;">Loading…</div>';

            try {
                const resp = await fetch('/Notifications/Dropdown', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                anchor.innerHTML = await resp.text();
            } catch {
                anchor.innerHTML = '<div style="padding:1rem;color:var(--text-dim);font-size:0.8rem;">Could not load.</div>';
            }
        };

        document.addEventListener('click', function (e) {
            if (notifOpen && !document.getElementById('notif-bell-wrap')?.contains(e.target)) {
                const anchor = document.getElementById('notif-dropdown-anchor');
                if (anchor) anchor.style.display = 'none';
                notifOpen = false;
            }
        });

        window.notifRowClick = async function (el, id, href) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            try {
                const resp = await fetch('/Notifications/MarkRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });
                const data = await resp.json();
                updateNotifBadge(data.unreadCount);
            } catch {}

            el.classList.remove('notif-unread');
            el.style.background = 'transparent';
            el.style.opacity = '0.55';
            const dot = el.querySelector('.notif-dot');
            if (dot) dot.style.display = 'none';

            if (href && href !== 'null' && href !== '') {
                window.location.href = href;
            }
        };

        window.notifMarkAllRead = async function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            try {
                await fetch('/Notifications/MarkAllRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                });
            } catch {}

            updateNotifBadge(0);
            document.querySelectorAll('.notif-row.notif-unread').forEach(row => {
                row.classList.remove('notif-unread');
                row.style.background = 'transparent';
                row.style.opacity = '0.55';
                const dot = row.querySelector('.notif-dot');
                if (dot) dot.style.display = 'none';
            });
            const headerBadge = document.getElementById('notif-header-badge');
            if (headerBadge) headerBadge.style.display = 'none';
        };

        window.notifRestoreHover = function (el) {
            el.style.background = el.classList.contains('notif-unread')
                ? 'rgba(232,93,74,0.045)'
                : 'transparent';
        };

        function updateNotifBadge(count) {
            const badge = document.getElementById('notif-badge');
            if (!badge) return;
            badge.style.display = count <= 0 ? 'none' : 'flex';
            badge.textContent = count > 99 ? '99+' : count;
        }
        // Add this to your script block at the bottom
        if (document.getElementById('notif-badge')) {
            fetch('/Notifications/UnreadCount')
                .then(r => r.json())
                .then(d => {
                    const badge = document.getElementById('notif-badge');
                    if (badge) {
                        badge.textContent = d.count > 99 ? '99+' : d.count;
                        badge.style.display = d.count > 0 ? 'flex' : 'none';
                    }
                });
        }
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>