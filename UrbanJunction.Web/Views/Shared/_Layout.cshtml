@using Microsoft.AspNetCore.Identity
@using UrbanJunction.Data.Models
@inject UserManager<UrbanUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    string profilePic = currentUser?.ProfilePicturePath ?? "/images/default.jpg";
    string username = User.Identity?.Name ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Junction</title>
    <link rel="icon" type="image/x-icon" href="~/images/logo.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UrbanJunction.Web.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- Offcanvas Menu -->
    <div class="offcanvas offcanvas-start text-white" tabindex="-1" id="mainMenu" aria-labelledby="mainMenuLabel">
        <div class="offcanvas-header py-3 px-4">
            <div class="d-flex align-items-center gap-2">
                <img src="~/images/logo.png" alt="Urban Junction" style="height:32px;width:auto;" />
                <h5 class="offcanvas-title mb-0 fw-bold" id="mainMenuLabel" style="color:#e8e0d5;">Urban Junction</h5>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body px-4">

            <div class="section-label">Explore Topics</div>
            <ul class="list-unstyled">
                <li class="mb-1">
                    <a class="text-decoration-none d-flex align-items-center gap-2 py-2"
                       asp-controller="Topics" asp-action="ByName" asp-route-name="Art"
                       style="color:#4caf72;">
                        <i class="fa-solid fa-palette fa-sm"></i> Art
                    </a>
                </li>
                <li class="mb-1">
                    <a class="text-decoration-none d-flex align-items-center gap-2 py-2"
                       asp-controller="Topics" asp-action="ByName" asp-route-name="Music"
                       style="color:#6c63ff;">
                        <i class="fa-solid fa-music fa-sm"></i> Music
                    </a>
                </li>
                <li class="mb-1">
                    <a class="text-decoration-none d-flex align-items-center gap-2 py-2"
                       asp-controller="Topics" asp-action="ByName" asp-route-name="Fashion"
                       style="color:#f5a623;">
                        <i class="fa-solid fa-shirt fa-sm"></i> Fashion
                    </a>
                </li>
            </ul>

            <hr />

            <div class="section-label">Other Sections</div>
            <ul class="list-unstyled">
                <li class="mb-1">
                    <a class="text-decoration-none d-flex align-items-center gap-2 py-2"
                       asp-controller="QA" asp-action="Index">
                        <i class="fa-solid fa-circle-question fa-sm"></i> Q&amp;A
                    </a>
                </li>
                <li class="mb-1">
                    <a class="text-decoration-none d-flex align-items-center gap-2 py-2"
                       asp-controller="Credits" asp-action="Index">
                        <i class="fa-solid fa-scroll fa-sm"></i> Credits
                    </a>
                </li>
            </ul>

            <hr />

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="section-label">Account</div>
                <ul class="list-unstyled">
                    <li class="mb-1">
                        <a class="text-decoration-none d-flex align-items-center gap-2 py-2"
                           asp-controller="Account" asp-action="Profile">
                            <i class="fa-solid fa-user fa-sm"></i> My Profile
                        </a>
                    </li>
                    <li class="mb-1">
                        <a class="text-decoration-none d-flex align-items-center gap-2 py-2"
                           asp-controller="Posts" asp-action="MyPosts">
                            <i class="fa-solid fa-pen-to-square fa-sm"></i> My Posts
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><hr /></li>
                        <li class="mb-1">
                            <a class="text-decoration-none d-flex align-items-center gap-2 py-2"
                               asp-controller="Admin" asp-action="Index" style="color:#f5a623;">
                                <i class="fa-solid fa-shield fa-sm"></i> Admin Panel
                            </a>
                        </li>
                    }
                    <li class="mb-1">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-link text-decoration-none p-0 d-flex align-items-center gap-2 py-2"
                                    style="color:#a09880;">
                                <i class="fa-solid fa-right-from-bracket fa-sm"></i> Logout
                            </button>
                        </form>
                    </li>
                </ul>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login"
                   class="btn btn-outline-light w-100 mt-3 rounded-pill">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Login
                </a>
            }
        </div>
    </div>

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark border-bottom mb-0">
            <div class="container-fluid d-flex justify-content-between align-items-center px-3">

                <div class="d-flex align-items-center gap-3">
                    <button class="menu-btn btn" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#mainMenu">
                        <i class="fa-solid fa-bars fa-sm"></i>
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="navbar-brand mb-0">
                        <img src="~/images/logo.png" alt="Urban Junction" class="site-logo" />
                    </a>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-controller="Account" asp-action="Profile"
                           class="d-flex align-items-center text-decoration-none gap-2">
                            <img src="@profilePic"
                                 onerror="this.src='/images/default.jpg'"
                                 class="profile-icon" />
                            <span style="font-size:14px;color:#a09880;">@username</span>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           class="btn btn-outline-light btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-right-to-bracket me-1"></i>Login
                        </a>
                    }
                </div>

            </div>
        </nav>
    </header>

    <div class="container-fluid px-0">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>