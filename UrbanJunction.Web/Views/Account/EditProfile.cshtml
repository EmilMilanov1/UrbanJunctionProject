@model EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-5" style="max-width: 500px;">
    <h3 class="text-center mb-4">Edit Profile</h3>

    <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
        <div class="form-group mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control bg-dark text-light border-secondary" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control bg-dark text-light border-secondary" readonly />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Change Profile Picture</label>
            @if (!string.IsNullOrEmpty(Model.ExistingProfilePictureUrl))
            {
                <div class="mb-2">
                    <img src="@Model.ExistingProfilePictureUrl" class="rounded-circle"
                         style="width: 60px; height: 60px; object-fit: cover;" />
                </div>
            }
            <input asp-for="ProfilePicture" type="file" class="form-control bg-dark text-light border-secondary" accept="image/*" />
        </div>
        
        <div class="form-group mb-4">
            <label class="form-label">Change Banner Image</label>
            @if (!string.IsNullOrEmpty(Model.ExistingBannerImageUrl))
            {
                <div class="mb-2">
                    <img src="@Model.ExistingBannerImageUrl"
                         style="width: 100%; height: 80px; object-fit: cover; border-radius: 6px;" />
                </div>
            }
            <input asp-for="BannerImage" type="file" class="form-control bg-dark text-light border-secondary" accept="image/*" />
        </div>

        <div class="d-flex justify-content-center gap-2 mt-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a onclick="history.back()" class="btn btn-outline-secondary">← Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}