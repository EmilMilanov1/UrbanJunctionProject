@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<style>
    .forum-layout {
        display: flex;
        justify-content: center;
    }

    .sidebar-left, .sidebar-right {
        display: none !important;
    }
</style>

<div style="min-height: calc(100vh - 56px); display: flex; align-items: center; justify-content: center; padding: 2rem 1rem;">
    <div style="width: 100%; max-width: 520px;">

        <!-- Logo -->
        <div style="text-align: center; margin-bottom: 2rem;">
            <img src="~/images/logo.png" alt="Urban Junction"
                 style="height: 52px; width: auto; margin-bottom: 0.75rem;
                        filter: drop-shadow(0 0 16px rgba(232,93,74,0.4));" />
            <div style="font-family: var(--font-head); font-size: 1.1rem; font-weight: 800;
                        color: var(--text); letter-spacing: -0.01em;">
                Urban Junction
            </div>
            <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--accent);
                        letter-spacing: 0.2em; text-transform: uppercase; margin-top: 0.2rem;">
                Welcome Back
            </div>
        </div>

        <!-- Card -->
        <div style="background: var(--bg-card); border: 1px solid var(--border-light);
                    border-radius: 12px; padding: 2rem; box-shadow: 0 8px 32px rgba(0,0,0,0.5);">

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly"
                     style="margin-bottom:1rem;padding:0.65rem 1rem;border-radius:6px;
                            font-size:0.83rem;border:1px solid rgba(232,93,74,0.3);
                            background:rgba(232,93,74,0.1);color:#f0a090;"></div>

                <div style="margin-bottom: 1.1rem;">
                    <label asp-for="UsernameOrEmail" class="form-label">Email or Username</label>
                    <input asp-for="UsernameOrEmail" class="form-control" placeholder="Enter your email or username" />
                    <span asp-validation-for="UsernameOrEmail" class="validation-message"></span>
                </div>

                <div style="margin-bottom: 1.1rem;">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div style="display: flex; gap: 0.5rem;">
                        <input asp-for="Password" type="password" class="form-control"
                               id="passwordInput" placeholder="Enter your password" />
                        <button type="button" id="togglePassword"
                                style="background: var(--bg-input); border: 1px solid var(--border);
                                       color: var(--text-muted); border-radius: 6px; padding: 0 0.85rem;
                                       font-size: 0.78rem; cursor: pointer; white-space: nowrap;
                                       transition: color 150ms, border-color 150ms; font-family: var(--font-mono);">
                            Show
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="validation-message"></span>
                </div>

                <div style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                    <input asp-for="RememberMe" class="form-check-input" style="margin:0;" />
                    <label asp-for="RememberMe"
                           style="font-size: 0.82rem; color: var(--text-muted); cursor: pointer; margin: 0;">
                        Remember Me
                    </label>
                </div>

                <button type="submit"
                        style="width:100%;padding:0.65rem;border-radius:6px;font-size:0.9rem;
                               background:var(--accent);border:none;color:#fff;font-weight:600;
                               cursor:pointer;font-family:var(--font-body);
                               transition:background 150ms;">
                    Log In
                </button>

                <div style="text-align: center; margin-top: 1.25rem;">
                    <span style="font-size: 0.8rem; color: var(--text-dim);">
                        Don't have an account?
                        <a asp-controller="Account" asp-action="Register"
                           style="color: var(--accent); text-decoration: none; font-weight: 500;">Sign Up</a>
                    </span>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('passwordInput');
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            this.textContent = isPassword ? 'Hide' : 'Show';
        });
    </script>
}