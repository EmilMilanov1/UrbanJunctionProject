@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<style>
    .forum-layout { display: block !important; }
    .sidebar-left, .sidebar-right { display: none !important; }
    body { padding-top: 0 !important; }
    header { display: none !important; }

    .auth-page {
        display: flex;
        min-height: 100vh;
    }

    /* ── Left panel ── */
    .auth-left {
        width: 45%;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 3rem;
    }
    .auth-left-bg {
        position: absolute;
        inset: 0;
        background: #0a0a0b;
        z-index: 0;
    }
    .auth-left-bg::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 60% 50% at 20% 30%, rgba(232,93,74,0.18) 0%, transparent 60%),
            radial-gradient(ellipse 40% 60% at 80% 70%, rgba(124,111,255,0.12) 0%, transparent 60%),
            radial-gradient(ellipse 50% 40% at 50% 90%, rgba(57,255,20,0.06) 0%, transparent 60%);
    }
    .auth-left-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
        opacity: 0.4;
    }
    .auth-left-stripes {
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(
            -45deg,
            transparent, transparent 40px,
            rgba(255,255,255,0.012) 40px,
            rgba(255,255,255,0.012) 41px
        );
        z-index: 1;
    }
    .auth-divider-line {
        position: absolute;
        top: 10%; bottom: 10%; right: 0;
        width: 1px;
        background: linear-gradient(to bottom, transparent, #2a2a2e 20%, #2a2a2e 80%, transparent);
    }
    .auth-left-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .auth-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .auth-logo-img {
        width: 42px; height: 42px;
        object-fit: contain;
        animation: logoPulse 3s ease-in-out infinite;
    }
    @@keyframes logoPulse {
        0%, 100% { filter: drop-shadow(0 0 12px rgba(232,93,74,0.4)); }
        50%       { filter: drop-shadow(0 0 28px rgba(232,93,74,0.7)); }
    }
    .auth-logo-name {
        font-family: var(--font-head);
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        color: var(--text);
    }
    .auth-logo-sub {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        color: var(--accent);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        display: block;
        margin-top: -2px;
    }
    .auth-headline h1 {
        font-family: var(--font-head);
        font-size: clamp(2.2rem, 3.5vw, 3.2rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.03em;
        color: var(--text);
    }
    .auth-headline h1 span {
        display: block;
        -webkit-text-stroke: 1px rgba(232,93,74,0.8);
        color: transparent;
    }
    .auth-headline p {
        margin-top: 0.85rem;
        font-size: 0.88rem;
        color: var(--text-dim);
        line-height: 1.65;
        max-width: 320px;
    }

    /* ── Right panel ── */
    .auth-page {
        display: flex;
        min-height: 100vh;
        width: 100vw;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 9999;
        overflow-y: auto;
    }

    .auth-left {
        width: 45%;
        min-height: 100vh; /* ADD THIS */
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 3rem;
    }

    .auth-right {
        flex: 1;
        min-height: 100vh; /* ADD THIS */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 4rem;
        position: relative;
        background: var(--bg);
        overflow-y: auto;
    }
    .auth-right::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 80% 20%, rgba(124,111,255,0.04) 0%, transparent 60%);
        pointer-events: none;
    }
    .auth-form-wrap {
        width: 100%;
        max-width: 380px;
        position: relative;
        z-index: 1;
        animation: slideUp 400ms cubic-bezier(0.16,1,0.3,1) forwards;
    }
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .auth-form-title {
        font-family: var(--font-head);
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.35rem;
        color: var(--text);
    }
    .auth-form-sub {
        font-size: 0.83rem;
        color: var(--text-muted);
        margin-bottom: 2rem;
    }
    .auth-form-sub a { color: var(--accent); text-decoration: none; font-weight: 500; }

    .auth-field { margin-bottom: 1.1rem; }
    .auth-field .form-label {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-dim);
        margin-bottom: 0.4rem;
        transition: color 150ms;
    }
    .auth-field:focus-within .form-label { color: var(--accent); }
    .auth-field .form-control {
        background: var(--bg-card) !important;
        border: 1px solid var(--border) !important;
        border-radius: 7px !important;
        color: var(--text) !important;
        font-size: 0.9rem;
        padding: 0.7rem 1rem !important;
        transition: border-color 150ms, box-shadow 150ms !important;
    }
    .auth-field .form-control:focus {
        border-color: var(--accent) !important;
        box-shadow: 0 0 0 3px rgba(232,93,74,0.1) !important;
    }

    .auth-toggle-btn {
        background: var(--bg-input);
        border: 1px solid var(--border);
        color: var(--text-muted);
        border-radius: 6px;
        padding: 0 0.85rem;
        font-size: 0.75rem;
        cursor: pointer;
        white-space: nowrap;
        transition: color 150ms, border-color 150ms;
        font-family: var(--font-mono);
        letter-spacing: 0.05em;
    }
    .auth-toggle-btn:hover { color: var(--text); border-color: var(--border-light); }

    .auth-remember {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }
    .auth-remember label {
        font-size: 0.82rem;
        color: var(--text-muted);
        cursor: pointer;
        margin: 0;
    }
    .auth-remember input[type=checkbox] { accent-color: var(--accent); }

    .auth-submit {
        width: 100%;
        background: var(--accent);
        color: #fff;
        font-family: var(--font-head);
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        padding: 0.85rem;
        border: none;
        border-radius: 7px;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: background 150ms, transform 150ms, box-shadow 150ms;
    }
    .auth-submit:hover {
        background: var(--accent-hover);
        transform: translateY(-1px);
        box-shadow: 0 6px 24px rgba(232,93,74,0.4);
    }
    .auth-submit::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 60%);
        pointer-events: none;
    }
    .auth-footer-link {
        text-align: center;
        margin-top: 1.25rem;
        font-size: 0.8rem;
        color: var(--text-dim);
    }
    .auth-footer-link a { color: var(--accent); text-decoration: none; font-weight: 500; }

    .auth-back {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        color: var(--text-dim);
        margin-top: 1.5rem;
        text-decoration: none;
        font-family: var(--font-mono);
        transition: color 150ms;
    }
    .auth-back:hover { color: var(--text-muted); }

    @@media (max-width: 768px) {
        .auth-left { display: none; }
        .auth-right { padding: 2rem 1.5rem; }
    }
    .grecaptcha-badge {
        z-index: 10000 !important;
    }

    .grecaptcha-badge {
        z-index: 10000 !important;
        filter: invert(1) hue-rotate(180deg) !important;
    }
</style>

<div class="auth-page">

    <!-- Left branding panel -->
    <div class="auth-left">
        <div class="auth-left-bg"></div>
        <div class="auth-left-stripes"></div>
        <div class="auth-divider-line"></div>
        <div class="auth-left-content">
            <div class="auth-logo">
                <img src="~/images/logo.png" alt="Urban Junction" class="auth-logo-img" />
                <div>
                    <div class="auth-logo-name">Urban Junction</div>
                    <span class="auth-logo-sub">Forum</span>
                </div>
            </div>
            <div class="auth-headline">
                <h1>
                    Welcome<br/>
                    <span>Back.</span>
                </h1>
                <p>Your corner of the culture is waiting. Jump back into the threads.</p>
            </div>
        </div>
    </div>

    <!-- Right form panel -->
    <div class="auth-right">
        <div class="auth-form-wrap">

            <div class="auth-form-title">Sign in</div>          
            <form asp-action="Login" method="post">

                <div asp-validation-summary="ModelOnly"
                     style="margin-bottom:1rem;padding:0.65rem 1rem;border-radius:6px;
                            font-size:0.83rem;border:1px solid rgba(232,93,74,0.3);
                            background:rgba(232,93,74,0.1);color:#f0a090;"></div>

                <div class="auth-field">
                    <label asp-for="UsernameOrEmail" class="form-label">Email or Username</label>
                    <input asp-for="UsernameOrEmail" class="form-control"
                           placeholder="Enter your email or username" autocomplete="username" />
                    <span asp-validation-for="UsernameOrEmail" class="validation-message"></span>
                </div>

                <div class="auth-field" style="margin-bottom:0.75rem;">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div style="display:flex;gap:0.5rem;">
                        <input asp-for="Password" type="password" class="form-control"
                               id="passwordInput" placeholder="Enter your password"
                               autocomplete="current-password" />
                        <button type="button" id="togglePassword" class="auth-toggle-btn">Show</button>
                    </div>
                    <span asp-validation-for="Password" class="validation-message"></span>
                </div>

                <div class="auth-remember">
                    <input asp-for="RememberMe" class="form-check-input" style="margin:0;" />
                    <label asp-for="RememberMe">Remember Me</label>
                </div>

                <button type="submit" class="auth-submit">Log In →</button>

                <div class="auth-footer-link">
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Register">Sign Up</a>
                </div>

                <a asp-controller="Home" asp-action="Index" class="auth-back">
                    ← Back to Urban Junction
                </a>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('passwordInput');
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            this.textContent = isPassword ? 'Hide' : 'Show';
        });
    </script>
}
