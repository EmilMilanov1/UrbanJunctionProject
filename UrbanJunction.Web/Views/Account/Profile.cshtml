@model ProfileViewModel
@{
    ViewData["Title"] = Model.Username + "'s Profile";
    string activeTab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab)) activeTab = "posts";
}

<div style="max-width:700px;margin:0 auto;padding:24px 16px;">

    <!-- Banner -->
    <div class="uj-profile-banner mb-0">
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <img src="@Model.BannerImageUrl" />
        }
    </div>

    <!-- Avatar -->
    <div style="margin-top:-50px;margin-bottom:10px;z-index:10;position:relative;">
        <img src="@(!string.IsNullOrEmpty(Model.ProfilePictureUrl) ? Model.ProfilePictureUrl : "/images/default.jpg")"
             onerror="this.src='/images/default.jpg'"
             class="uj-profile-avatar" />
    </div>

    <!-- Username row -->
    <div class="d-flex align-items-start justify-content-between mb-1">
        <div>
            <h4 style="color:#e8e0d5;font-weight:700;margin-bottom:2px;">@Model.Username</h4>
            <p style="color:#6b6358;margin:0;font-size:14px;">@@@Model.Username</p>
        </div>
        @if (Model.IsOwnProfile)
        {
            <a asp-action="EditProfile" class="btn btn-outline-light btn-sm rounded-pill px-3 mt-1">
                <i class="fa-solid fa-pen me-1"></i> Edit Profile
            </a>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-action="ToggleFollow" asp-controller="Account" method="post" class="mt-1">
                @Html.AntiForgeryToken()
                <input type="hidden" name="targetUserId" value="@Model.UserId" />
                <button type="submit"
                        class="btn btn-sm rounded-pill px-3 @(Model.IsFollowedByCurrentUser ? "btn-outline-light" : "")"
                        style="@(Model.IsFollowedByCurrentUser ? "" : "background:#e85d4a;border:none;color:white;")">
                    @(Model.IsFollowedByCurrentUser ? "Unfollow" : "Follow")
                </button>
            </form>
        }
    </div>

    <!-- Bio -->
    @if (!string.IsNullOrEmpty(Model.Bio))
    {
        <p style="color:#d0c8be;font-size:14px;margin-bottom:12px;line-height:1.6;">@Model.Bio</p>
    }

    <!-- Follower counts -->
    <div class="d-flex gap-4 mb-4 mt-2">
        <a href="#" class="text-decoration-none" data-bs-toggle="modal" data-bs-target="#followersModal">
            <span style="color:#e8e0d5;font-weight:700;">@Model.FollowerCount</span>
            <span style="color:#6b6358;font-size:13px;margin-left:4px;">Followers</span>
        </a>
        <a href="#" class="text-decoration-none" data-bs-toggle="modal" data-bs-target="#followingModal">
            <span style="color:#e8e0d5;font-weight:700;">@Model.FollowingCount</span>
            <span style="color:#6b6358;font-size:13px;margin-left:4px;">Following</span>
        </a>
    </div>

    <!-- Tabs -->
    <div class="d-flex gap-4 mb-4" style="border-bottom:1px solid rgba(255,255,255,0.07);">
        <a href="?tab=posts" class="uj-tab-link @(activeTab == "posts" ? "active" : "")">Posts</a>
        <a href="?tab=likes" class="uj-tab-link @(activeTab == "likes" ? "active" : "")">Likes</a>
    </div>

    <!-- Posts Tab -->
    @if (activeTab == "posts")
    {
        @if (!Model.Posts.Any())
        {
            <p style="color:#6b6358;text-align:center;margin-top:32px;">No posts yet.</p>
        }
        else
        {
            @foreach (var post in Model.Posts)
            {
                string tn = post.Subcategory?.Topic?.Name ?? "";
                string tc = tn.ToLower() switch { "art" => "art", "music" => "music", "fashion" => "fashion", _ => "default" };
                <div class="uj-profile-post-card">
                    @if (post.Images != null && post.Images.Any())
                    {
                        <img src="@post.Images.First().ImagePath"
                             style="width:100%;height:180px;object-fit:cover;" />
                    }
                    <div style="padding:14px 16px;">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h6 style="color:#e8e0d5;font-weight:600;margin:0;font-size:15px;">@post.Title</h6>
                            <span class="uj-tag @tc">@(post.Subcategory?.Name ?? tn)</span>
                        </div>
                        <p style="color:#6b6358;font-size:13px;margin:6px 0 10px;line-height:1.5;">
                            @(post.Content?.Length > 120 ? post.Content.Substring(0, 120) + "..." : post.Content)
                        </p>
                        <div class="d-flex align-items-center gap-3">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-action="ToggleLike" asp-controller="Posts" asp-route-id="@post.Id"
                                      method="post" class="d-inline like-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="d-flex align-items-center gap-1"
                                            style="background:none;border:none;cursor:pointer;color:#6b6358;font-size:13px;padding:0;">
                                        <i class="like-icon fa-regular fa-heart" style="color:#e25555;"></i>
                                        <span class="like-count">@post.Reactions.Count()</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login"
                                   class="d-flex align-items-center gap-1 text-decoration-none"
                                   style="color:#6b6358;font-size:13px;">
                                    <i class="fa-regular fa-heart" style="color:#e25555;"></i>
                                    <span>@post.Reactions.Count()</span>
                                </a>
                            }
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                               class="d-flex align-items-center gap-1 text-decoration-none"
                               style="color:#6b6358;font-size:13px;">
                                <i class="fa-regular fa-comment"></i>
                                <span>@post.Comments.Count()</span>
                            </a>
                            <span style="color:#6b6358;font-size:12px;">@post.CreatedOn.ToString("dd MMM yyyy")</span>
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                               class="ms-auto btn btn-sm rounded-pill px-3"
                               style="border:1px solid rgba(255,255,255,0.12);color:#a09880;font-size:12px;">
                                View Post
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    }

    <!-- Likes Tab -->
    @if (activeTab == "likes")
    {
        @if (!Model.LikedPosts.Any())
        {
            <p style="color:#6b6358;text-align:center;margin-top:32px;">No liked posts yet.</p>
        }
        else
        {
            @foreach (var post in Model.LikedPosts)
            {
                string tn2 = post.Subcategory?.Topic?.Name ?? "";
                string tc2 = tn2.ToLower() switch { "art" => "art", "music" => "music", "fashion" => "fashion", _ => "default" };
                <div class="uj-profile-post-card">
                    @if (post.Images != null && post.Images.Any())
                    {
                        <img src="@post.Images.First().ImagePath"
                             style="width:100%;height:180px;object-fit:cover;" />
                    }
                    <div style="padding:14px 16px;">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h6 style="color:#e8e0d5;font-weight:600;margin:0;font-size:15px;">@post.Title</h6>
                            <span class="uj-tag @tc2">@(post.Subcategory?.Name ?? tn2)</span>
                        </div>
                        <p style="color:#6b6358;font-size:13px;margin:6px 0 10px;line-height:1.5;">
                            @(post.Content?.Length > 120 ? post.Content.Substring(0, 120) + "..." : post.Content)
                        </p>
                        <div class="d-flex align-items-center gap-3">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-action="ToggleLike" asp-controller="Posts" asp-route-id="@post.Id"
                                      method="post" class="d-inline like-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="d-flex align-items-center gap-1"
                                            style="background:none;border:none;cursor:pointer;color:#6b6358;font-size:13px;padding:0;">
                                        <i class="like-icon fa-solid fa-heart" style="color:#e25555;"></i>
                                        <span class="like-count">@post.Reactions.Count()</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login"
                                   class="d-flex align-items-center gap-1 text-decoration-none"
                                   style="color:#6b6358;font-size:13px;">
                                    <i class="fa-solid fa-heart" style="color:#e25555;"></i>
                                    <span>@post.Reactions.Count()</span>
                                </a>
                            }
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                               class="d-flex align-items-center gap-1 text-decoration-none"
                               style="color:#6b6358;font-size:13px;">
                                <i class="fa-regular fa-comment"></i>
                                <span>@post.Comments.Count()</span>
                            </a>
                            <span style="color:#6b6358;font-size:12px;">@post.CreatedOn.ToString("dd MMM yyyy")</span>
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                               class="ms-auto btn btn-sm rounded-pill px-3"
                               style="border:1px solid rgba(255,255,255,0.12);color:#a09880;font-size:12px;">
                                View Post
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

<!-- Followers Modal -->
<div class="modal fade" id="followersModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Followers</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!Model.Followers.Any())
                {
                    <p style="color:#6b6358;text-align:center;">No followers yet.</p>
                }
                else
                {
                    @foreach (var u in Model.Followers)
                    {
                        <a href="/u/@u.Username" class="d-flex align-items-center gap-3 text-decoration-none mb-3">
                            <img src="@(u.ProfilePictureUrl ?? "/images/default.jpg")"
                                 onerror="this.src='/images/default.jpg'"
                                 style="width:42px;height:42px;border-radius:50%;object-fit:cover;" />
                            <span style="color:#d0c8be;font-weight:500;">@u.Username</span>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Following Modal -->
<div class="modal fade" id="followingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Following</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!Model.FollowingUsers.Any())
                {
                    <p style="color:#6b6358;text-align:center;">Not following anyone yet.</p>
                }
                else
                {
                    @foreach (var u in Model.FollowingUsers)
                    {
                        <a href="/u/@u.Username" class="d-flex align-items-center gap-3 text-decoration-none mb-3">
                            <img src="@(u.ProfilePictureUrl ?? "/images/default.jpg")"
                                 onerror="this.src='/images/default.jpg'"
                                 style="width:42px;height:42px;border-radius:50%;object-fit:cover;" />
                            <span style="color:#d0c8be;font-weight:500;">@u.Username</span>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.like-form').forEach(form => {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const icon = this.querySelector('.like-icon');
                    const count = this.querySelector('.like-count');
                    const token = this.querySelector('input[name="__RequestVerificationToken"]').value;
                    try {
                        const response = await fetch(this.action, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token,
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                        });
                        if (response.ok) {
                            const data = await response.json();
                            count.textContent = data.count;
                            if (data.userLiked) {
                                icon.classList.replace('fa-regular', 'fa-solid');
                            } else {
                                icon.classList.replace('fa-solid', 'fa-regular');
                            }
                        }
                    } catch (err) { console.error('Like failed', err); }
                });
            });
        });
    </script>
}