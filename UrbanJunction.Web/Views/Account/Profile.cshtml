@model ProfileViewModel
@using UrbanJunction.Data.Models
@{
    ViewData["Title"] = Model.Username + "'s Profile";
    string activeTab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab)) activeTab = "posts";
    var userVotes = ViewBag.UserVotes as Dictionary<int, string> ?? new Dictionary<int, string>();
    string currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    bool canReportUser = User.Identity?.IsAuthenticated == true && currentUserId != Model.UserId;
}

<div style="max-width: 860px; margin: 0 auto; padding: 0 1rem 3rem;">

    <!-- Banner -->
    <div style="width:100%;height:200px;border-radius:0 0 12px 12px;overflow:hidden;
                background:linear-gradient(135deg,#1a1014,#0e1a14,#0e0f1a);position:relative;">
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <img src="@Model.BannerImageUrl"
                 style="width:100%;height:100%;object-fit:cover;display:block;" />
        }
    </div>

    <!-- Header row -->
    <div style="display:flex;align-items:flex-end;justify-content:space-between;
                padding:0 1.5rem;margin-top:-40px;margin-bottom:1rem;">
        <div style="position:relative;z-index:10;">
            <img src="@(!string.IsNullOrEmpty(Model.ProfilePictureUrl) ? Model.ProfilePictureUrl : "/images/default.jpg")"
                 onerror="this.src='/images/default.jpg'"
                 style="width:80px;height:80px;border-radius:50%;object-fit:cover;
                        border:3px solid var(--bg);display:block;" />
        </div>
        <div style="margin-bottom:0.25rem;display:flex;align-items:center;gap:0.5rem;">
            @if (Model.IsOwnProfile)
            {
                <a asp-action="EditProfile"
                   style="display:inline-flex;align-items:center;gap:0.4rem;
                          padding:0.4rem 1rem;border-radius:6px;font-size:0.82rem;
                          font-weight:600;border:1px solid var(--border-light);
                          color:var(--text-muted);transition:all 150ms;text-decoration:none;"
                   onmouseover="this.style.color='var(--text)';this.style.borderColor='var(--text-dim)'"
                   onmouseout="this.style.color='var(--text-muted)';this.style.borderColor='var(--border-light)'">
                    <i class="fa-solid fa-pen fa-xs"></i> Edit Profile
                </a>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-action="ToggleFollow" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="targetUserId" value="@Model.UserId" />
                    <button type="submit" class="btn-follow @(Model.IsFollowedByCurrentUser ? "following" : "")">
                        @(Model.IsFollowedByCurrentUser ? "Unfollow" : "Follow")
                    </button>
                </form>
            }

            @if (canReportUser)
            {
                <button type="button"
                        style="background:none;border:1px solid var(--border);cursor:pointer;
                               font-size:0.72rem;color:var(--text-dim);padding:0.4rem 0.6rem;
                               border-radius:6px;transition:all 150ms;"
                        onmouseover="this.style.color='var(--accent)';this.style.borderColor='rgba(232,93,74,0.3)'"
                        onmouseout="this.style.color='var(--text-dim)';this.style.borderColor='var(--border)'"
                        data-bs-toggle="modal" data-bs-target="#reportUserModal"
                        title="Report user">
                    <i class="fa-solid fa-flag fa-xs"></i>
                </button>
            }
        </div>
    </div>

    <!-- Name + bio + stats -->
    <div style="padding:0 1.5rem;margin-bottom:1.5rem;">
        <div style="font-family:var(--font-head);font-size:1.3rem;font-weight:800;
                    letter-spacing:-0.02em;color:var(--text);margin-bottom:0.15rem;">
            @Model.Username
        </div>
        <div style="font-family:var(--font-mono);font-size:0.75rem;color:var(--text-dim);margin-bottom:0.6rem;">
            @@@Model.Username
        </div>
        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;
                      margin-bottom:0.75rem;max-width:520px;">@Model.Bio</p>
        }
        <div style="display:flex;gap:1.5rem;">
            <a href="#" data-bs-toggle="modal" data-bs-target="#followersModal"
               style="text-decoration:none;display:flex;align-items:baseline;gap:0.3rem;">
                <span style="font-family:var(--font-mono);font-size:1rem;font-weight:500;color:var(--text);">@Model.FollowerCount</span>
                <span style="font-size:0.75rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.05em;">Followers</span>
            </a>
            <a href="#" data-bs-toggle="modal" data-bs-target="#followingModal"
               style="text-decoration:none;display:flex;align-items:baseline;gap:0.3rem;">
                <span style="font-family:var(--font-mono);font-size:1rem;font-weight:500;color:var(--text);">@Model.FollowingCount</span>
                <span style="font-size:0.75rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.05em;">Following</span>
            </a>
        </div>
    </div>

    <!-- Tabs -->
    <div style="display:flex;border-bottom:1px solid var(--border);padding:0 1.5rem;margin-bottom:1.25rem;">
        <a href="?tab=posts"
           style="font-size:0.85rem;font-weight:500;padding:0.6rem 1rem;
                  border-bottom:2px solid @(activeTab == "posts" ? "var(--accent)" : "transparent");
                  color:@(activeTab == "posts" ? "var(--text)" : "var(--text-muted)");
                  text-decoration:none;margin-bottom:-1px;transition:color 150ms;">
            Posts <span style="font-family:var(--font-mono);font-size:0.7rem;color:var(--text-dim);margin-left:0.3rem;">@Model.Posts.Count()</span>
        </a>
        <a href="?tab=likes"
           style="font-size:0.85rem;font-weight:500;padding:0.6rem 1rem;
                  border-bottom:2px solid @(activeTab == "likes" ? "var(--accent)" : "transparent");
                  color:@(activeTab == "likes" ? "var(--text)" : "var(--text-muted)");
                  text-decoration:none;margin-bottom:-1px;transition:color 150ms;">
            Likes <span style="font-family:var(--font-mono);font-size:0.7rem;color:var(--text-dim);margin-left:0.3rem;">@Model.LikedPosts.Count()</span>
        </a>
    </div>

    @{
        var activePosts = activeTab == "likes" ? Model.LikedPosts : Model.Posts;
        bool isLikesTab = activeTab == "likes";
    }

    @if (!activePosts.Any())
    {
        <div style="text-align:center;padding:4rem 0;color:var(--text-dim);">
            <i class="fa-regular fa-face-sad-tear fa-2x" style="display:block;margin-bottom:0.75rem;"></i>
            @(isLikesTab ? "No liked posts yet." : "No posts yet.")
        </div>
    }
    else
    {
        <div class="thread-list">
            @foreach (var post in activePosts)
            {
                string tn = post.Subcategory?.Topic?.Name ?? "";
                string tc = tn.ToLower() switch
                {
                    "art"     => "art",
                    "music"   => "music",
                    "fashion" => "fashion",
                    _         => "default"
                };
                var subcatName    = post.Subcategory?.Name ?? "";
                var firstImage    = post.Images?.FirstOrDefault()?.ImagePath;
                var reactionCount = (post.Reactions?.Count(r => r.IsUpvote) ?? 0) - (post.Reactions?.Count(r => !r.IsUpvote) ?? 0);
                var commentCount  = post.Comments?.Count() ?? 0;
                var currentVote   = userVotes.GetValueOrDefault(post.Id, "");
                var preview = post.Content?.Length > 120
                    ? post.Content.Substring(0, 120) + "…"
                    : post.Content ?? "";

                <div class="thread-row" data-subcat="@subcatName">

                    <!-- Vote strip -->
                    <div class="thread-vote">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button class="vote-btn upvote feed-vote-btn @(currentVote == "up" ? "vote-active-up" : "")"
                                    data-post-id="@post.Id" data-is-upvote="true"
                                    data-user-vote="@currentVote" title="Upvote">
                                <i class="fa-solid fa-chevron-up"></i>
                            </button>
                            <span class="vote-count feed-vote-score @(reactionCount > 0 ? "positive" : reactionCount < 0 ? "negative" : "")"
                                  data-post-id="@post.Id">
                                @reactionCount
                            </span>
                            <button class="vote-btn downvote feed-vote-btn @(currentVote == "down" ? "vote-active-down" : "")"
                                    data-post-id="@post.Id" data-is-upvote="false"
                                    data-user-vote="@currentVote" title="Downvote">
                                <i class="fa-solid fa-chevron-down"></i>
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="vote-btn upvote" title="Login to vote">
                                <i class="fa-solid fa-chevron-up"></i>
                            </a>
                            <span class="vote-count @(reactionCount > 0 ? "positive" : reactionCount < 0 ? "negative" : "")">
                                @reactionCount
                            </span>
                            <a asp-controller="Account" asp-action="Login" class="vote-btn downvote" title="Login to vote">
                                <i class="fa-solid fa-chevron-down"></i>
                            </a>
                        }
                    </div>

                    <!-- Thread content -->
                    <div class="thread-content">
                        <div class="thread-text">
                            <div class="thread-tags">
                                <span class="thread-tag @tc">@tn</span>
                                @if (!string.IsNullOrEmpty(subcatName))
                                {
                                    <span class="thread-tag custom">@subcatName</span>
                                }
                            </div>
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                               class="thread-title-link text-decoration-none">
                                @post.Title
                            </a>
                            @if (!string.IsNullOrEmpty(preview))
                            {
                                <div class="thread-preview">@preview</div>
                            }
                            <div class="thread-meta">
                                <span class="thread-time">@post.CreatedOn.ToString("dd MMM yyyy")</span>
                                
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(firstImage))
                        {
                            <div class="thread-thumb">
                                <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id">
                                    <img src="@firstImage" onerror="this.style.display='none'" alt="@post.Title" />
                                </a>
                            </div>
                        }
                    </div>

                    <div class="thread-replies">
                        <span class="thread-reply-count">@commentCount</span>
                        <span class="thread-reply-label">replies</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Report User Modal -->
@if (canReportUser)
{
    <div class="modal fade" id="reportUserModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
            <div class="modal-content"
                 style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:10px;">
                <div class="modal-header" style="border-bottom:1px solid var(--border);">
                    <h6 class="modal-title"
                        style="font-family:var(--font-mono);font-size:0.7rem;
                               letter-spacing:0.12em;text-transform:uppercase;color:var(--text-dim);">
                        Report @Model.Username
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Reports" asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reportedUserId" value="@Model.UserId" />
                    <input type="hidden" name="returnUrl" value="/u/@Model.Username" />
                    <div class="modal-body" style="padding:1.25rem;">
                        <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1rem;">
                            Why are you reporting this user?
                        </p>
                        <div style="display:flex;flex-direction:column;gap:0.5rem;">
                            @foreach (ReportReason r in Enum.GetValues(typeof(ReportReason)))
                            {
                                <label style="display:flex;align-items:center;gap:0.6rem;
                                              padding:0.55rem 0.75rem;border-radius:6px;
                                              border:1px solid var(--border);cursor:pointer;
                                              font-size:0.83rem;color:var(--text-muted);
                                              transition:border-color 150ms,color 150ms;"
                                       onmouseover="this.style.borderColor='var(--border-light)';this.style.color='var(--text)'"
                                       onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">
                                    <input type="radio" name="reason" value="@((int)r)"
                                           style="accent-color:var(--accent);" />
                                    @(r switch {
                                        ReportReason.Spam => "Spam",
                                        ReportReason.Harassment => "Harassment",
                                        ReportReason.HateSpeech => "Hate Speech",
                                        ReportReason.Misinformation => "Misinformation",
                                        ReportReason.InappropriateContent => "Inappropriate Content",
                                        _ => r.ToString()
                                    })
                                </label>
                            }
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid var(--border);padding:0.75rem 1.25rem;">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-bs-dismiss="modal">Cancel</button>
                        <button type="submit"
                                style="background:var(--accent);color:#fff;border:none;
                                       padding:0.4rem 1rem;border-radius:6px;font-size:0.82rem;cursor:pointer;">
                            Submit Report
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Followers Modal -->
<div class="modal fade" id="followersModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Followers</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!Model.Followers.Any())
                {
                    <p style="color:var(--text-dim);text-align:center;">No followers yet.</p>
                }
                else
                {
                    @foreach (var u in Model.Followers)
                    {
                        <a href="/u/@u.Username"
                           style="display:flex;align-items:center;gap:0.75rem;text-decoration:none;margin-bottom:0.75rem;">
                            <img src="@(u.ProfilePictureUrl ?? "/images/default.jpg")"
                                 onerror="this.src='/images/default.jpg'"
                                 style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:1px solid var(--border-light);" />
                            <span style="font-size:0.875rem;font-weight:500;color:var(--text-muted);">@u.Username</span>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Following Modal -->
<div class="modal fade" id="followingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Following</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!Model.FollowingUsers.Any())
                {
                    <p style="color:var(--text-dim);text-align:center;">Not following anyone yet.</p>
                }
                else
                {
                    @foreach (var u in Model.FollowingUsers)
                    {
                        <a href="/u/@u.Username"
                           style="display:flex;align-items:center;gap:0.75rem;text-decoration:none;margin-bottom:0.75rem;">
                            <img src="@(u.ProfilePictureUrl ?? "/images/default.jpg")"
                                 onerror="this.src='/images/default.jpg'"
                                 style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:1px solid var(--border-light);" />
                            <span style="font-size:0.875rem;font-weight:500;color:var(--text-muted);">@u.Username</span>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            document.querySelectorAll('.thread-row').forEach(row => {
                row.style.cursor = 'pointer';
                row.addEventListener('click', function (e) {
                    if (e.target.closest('.thread-vote') ||
                        e.target.closest('a') ||
                        e.target.closest('button') ||
                        e.target.closest('form')) return;
                    const link = this.querySelector('.thread-title-link');
                    if (link) window.location.href = link.href;
                });
            });

            document.querySelectorAll('.feed-vote-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const postId   = this.dataset.postId;
                    const isUpvote = this.dataset.isUpvote === 'true';
                    const token    = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                    try {
                        const response = await fetch(`/Posts/Vote/${postId}?isUpvote=${isUpvote}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token,
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: `__RequestVerificationToken=${encodeURIComponent(token)}`
                        });
                        if (response.ok) {
                            const data = await response.json();
                            const scoreEl = document.querySelector(`.feed-vote-score[data-post-id="${postId}"]`);
                            if (scoreEl) {
                                scoreEl.textContent = data.score;
                                scoreEl.className = 'vote-count feed-vote-score' +
                                    (data.score > 0 ? ' positive' : data.score < 0 ? ' negative' : '');
                            }
                            const upBtn   = document.querySelector(`.feed-vote-btn.upvote[data-post-id="${postId}"]`);
                            const downBtn = document.querySelector(`.feed-vote-btn.downvote[data-post-id="${postId}"]`);
                            if (upBtn && downBtn) {
                                upBtn.classList.toggle('vote-active-up',     data.userVote === 'up');
                                downBtn.classList.toggle('vote-active-down', data.userVote === 'down');
                            }
                        }
                    } catch (err) { console.error('Vote failed', err); }
                });
            });

        });
    </script>
}
