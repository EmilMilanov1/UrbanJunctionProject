@model UrbanJunction.Data.Models.Post

@{
    ViewData["Title"] = "Post Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@Model.Title</h2>

<p class="text-muted">
    Posted by <strong>@Model.User.UserName</strong> in
    <strong>@Model.Subcategory.Topic.Name / @Model.Subcategory.Name</strong>
    on @Model.CreatedOn.ToShortDateString()
</p>

<hr />

<div class="bg-dark text-light p-4 rounded">
    <p>@Model.Content</p>
</div>

@if (Model.Images != null && Model.Images.Any())
{
    <div id="detailsCarousel" class="carousel slide mt-4" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Images.Count(); i++)
            {
                var image = Model.Images.ElementAt(i);
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@image.ImagePath" class="d-block w-100 rounded"
                         style="max-height: 500px; object-fit: cover;" alt="Post Image">
                </div>
            }
        </div>
        @if (Model.Images.Count() > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#detailsCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#detailsCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
                <span class="visually-hidden">Next</span>
            </button>
        }
    </div>
}

<a onclick="history.back()" class="btn btn-outline-secondary mt-3">← Back</a>