@using UrbanJunction.Data.Models
@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var myMessages = ViewBag.MyMessages as List<ContactMessage> ?? new List<ContactMessage>();
    int? selectedId = ViewBag.SelectedMsgId as int?;
    var selected = myMessages.FirstOrDefault(m => m.Id == selectedId);
    string userPic = ViewBag.UserPic as string ?? "";
    string userName = User.Identity?.Name ?? "You";
    string userInitial = userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U";
}

@section RightSidebar {
    @if (myMessages.Any())
    {
        <div class="widget" style="padding:0;overflow:hidden;">
            <div class="widget-title" style="padding:0.85rem 1rem;margin:0;border-radius:0;">
                <i class="fa-solid fa-envelope fa-xs me-1"></i> Your Messages
            </div>
            @foreach (var msg in myMessages)
            {
                bool isActive = msg.Id == selectedId;
                <a href="?msgId=@msg.Id"
                   style="display:block;padding:0.65rem 1rem;
                          border-left:2px solid @(isActive ? "var(--accent)" : "transparent");
                          background:@(isActive ? "var(--bg-hover)" : "transparent");
                          text-decoration:none;transition:all 120ms;
                          border-bottom:1px solid var(--border);">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
                        <span style="font-size:0.78rem;font-weight:600;color:var(--text);
                                     white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:140px;">
                            @msg.Subject
                        </span>
                        @if (!string.IsNullOrEmpty(msg.AdminReply))
                        {
                            <span style="font-family:var(--font-mono);font-size:0.58rem;padding:0.1rem 0.35rem;
                                         border-radius:3px;background:rgba(76,175,114,0.12);color:var(--art);
                                         white-space:nowrap;flex-shrink:0;">
                                replied
                            </span>
                        }
                    </div>
                    <div style="font-family:var(--font-mono);font-size:0.65rem;color:var(--text-dim);margin-top:0.15rem;">
                        @msg.CreatedOn.ToString("dd MMM yyyy")
                    </div>
                </a>
            }
        </div>
    }
}

<div style="max-width:620px;margin:0 auto;padding:2rem 1rem 4rem;">

    <!-- Header -->
    <div style="margin-bottom:1.75rem;">
        <h1 style="font-family:var(--font-head);font-size:1.6rem;font-weight:800;
                   letter-spacing:-0.02em;color:var(--text);margin:0 0 0.4rem;">
            Contact Us
        </h1>
        <p style="font-size:0.85rem;color:var(--text-dim);margin:0;">
            Have an issue or feedback? Send us a message and we'll get back to you.
        </p>
    </div>

    <!-- Banners -->
    @if (TempData["Success"] != null)
    {
        <div style="padding:0.85rem 1rem;background:rgba(76,175,114,0.08);border:1px solid rgba(76,175,114,0.2);
                    border-radius:8px;color:var(--art);font-size:0.85rem;margin-bottom:1.5rem;
                    display:flex;align-items:center;gap:0.5rem;">
            <i class="fa-solid fa-circle-check fa-xs"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="padding:0.85rem 1rem;background:rgba(232,93,74,0.08);border:1px solid rgba(232,93,74,0.2);
                    border-radius:8px;color:var(--accent);font-size:0.85rem;margin-bottom:1.5rem;
                    display:flex;align-items:center;gap:0.5rem;">
            <i class="fa-solid fa-circle-exclamation fa-xs"></i> @TempData["Error"]
        </div>
    }

    <!-- Selected message thread -->
    @if (selected != null)
    {
        <div style="background:var(--bg-card);border:1px solid var(--border);
                    border-radius:10px;margin-bottom:1.5rem;overflow:hidden;">

            <!-- Thread header -->
            <div style="display:flex;justify-content:space-between;align-items:center;
                        padding:1rem 1.25rem;border-bottom:1px solid var(--border);">
                <span style="font-weight:700;color:var(--text);font-size:0.9rem;letter-spacing:-0.01em;">
                    @selected.Subject
                </span>
                <span style="font-family:var(--font-mono);font-size:0.65rem;color:var(--text-dim);">
                    @selected.CreatedOn.ToString("dd MMM yyyy")
                </span>
            </div>

            <!-- Bubbles -->
            <div style="padding:1.25rem;display:flex;flex-direction:column;gap:1.1rem;">

                <!-- User bubble (right) -->
                <div style="display:flex;align-items:flex-start;gap:0.6rem;flex-direction:row-reverse;">
                    <img src="@(string.IsNullOrEmpty(userPic) ? "/images/default.jpg" : userPic)"
                         onerror="this.src='/images/default.jpg'"
                         style="width:30px;height:30px;border-radius:50%;object-fit:cover;
                                flex-shrink:0;border:1px solid var(--border-light);" />
                    <div style="display:flex;flex-direction:column;align-items:flex-end;max-width:78%;min-width;">
                        <div style="display:inline-block;width:fit-content;
                                    background:var(--bg-hover);border:1px solid var(--border);
                                    border-radius:12px 12px 3px 12px;padding:0.6rem 0.85rem;">
                            <div style="font-size:0.84rem;color:var(--text-muted);line-height:0.8;
                                        word-break:break-word;">
                                @selected.Message
                            </div>
                        </div>
                        <div style="font-family:var(--font-mono);font-size:0.6rem;color:var(--text-dim);
                                    margin-top:0.3rem;">
                            You · @selected.CreatedOn.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>

                <!-- Admin reply bubble (left) or pending -->
                @if (!string.IsNullOrEmpty(selected.AdminReply))
                {
                    <div style="display:flex;align-items:flex-start;gap:0.6rem;">
                        <div style="width:30px;height:30px;border-radius:50%;flex-shrink:0;
                                    display:flex;align-items:center;justify-content:center;
                                    font-size:11px;font-weight:700;color:var(--accent);
                                    background:rgba(232,93,74,0.08);border:2px solid rgba(232,93,74,0.3);">
                            A
                        </div>
                        <div style="display:flex;flex-direction:column;align-items:flex-start;max-width:78%;">
                            <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.35rem;">
                                <span style="font-family:var(--font-mono);font-size:0.58rem;text-transform:uppercase;
                                             letter-spacing:0.1em;padding:0.12rem 0.4rem;border-radius:3px;
                                             background:rgba(232,93,74,0.15);color:var(--accent);">
                                    Admin
                                </span>
                                <span style="font-family:var(--font-mono);font-size:0.6rem;color:var(--text-dim);">
                                    @selected.RepliedOn?.ToString("dd MMM yyyy")
                                </span>
                            </div>
                            <div style="display:inline-block;width:fit-content;
                                        background:rgba(232,93,74,0.06);border:1px solid rgba(232,93,74,0.18);
                                        border-radius:3px 12px 12px 12px;padding:0.6rem 0.85rem;">
                                <div style="font-size:0.84rem;color:var(--text-muted);line-height:0.8;min-width;
                                    word-break:break-word;text-align:left;">
                                    @selected.AdminReply
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="display:flex;align-items:center;gap:0.5rem;padding:0.45rem 0.75rem;
                                border:1px dashed var(--border);border-radius:8px;
                                width:fit-content;margin-left:38px;">
                        <div style="width:6px;height:6px;border-radius:50%;background:var(--text-dim);
                                    animation:uj-blink 1.4s ease-in-out infinite;"></div>
                        <span style="font-family:var(--font-mono);font-size:0.68rem;color:var(--text-dim);">
                            Awaiting reply
                        </span>
                    </div>
                }

            </div>
        </div>
    }

    <!-- New message form -->
    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:1.75rem;">

        <div style="font-family:var(--font-mono);font-size:0.65rem;text-transform:uppercase;
                    letter-spacing:0.1em;color:var(--text-dim);margin-bottom:1.25rem;">
            Send a new message
        </div>

        <form asp-action="Submit" asp-controller="QA" method="post">
            @Html.AntiForgeryToken()

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
                <div>
                    <label style="display:block;font-family:var(--font-mono);font-size:0.65rem;
                                  text-transform:uppercase;letter-spacing:0.1em;color:var(--text-dim);
                                  margin-bottom:0.4rem;">Name</label>
                    <input type="text" name="name" value="@ViewBag.Name" required maxlength="100"
                           style="width:100%;background:var(--bg);border:1px solid var(--border);
                                  border-radius:6px;padding:0.55rem 0.75rem;color:var(--text);
                                  font-size:0.85rem;font-family:var(--font-body);outline:none;
                                  transition:border-color 150ms;box-sizing:border-box;"
                           onfocus="this.style.borderColor='var(--accent)'"
                           onblur="this.style.borderColor='var(--border)'" />
                </div>
                <div>
                    <label style="display:block;font-family:var(--font-mono);font-size:0.65rem;
                                  text-transform:uppercase;letter-spacing:0.1em;color:var(--text-dim);
                                  margin-bottom:0.4rem;">Email</label>
                    <input type="email" name="email" value="@ViewBag.Email" required maxlength="200"
                           style="width:100%;background:var(--bg);border:1px solid var(--border);
                                  border-radius:6px;padding:0.55rem 0.75rem;color:var(--text);
                                  font-size:0.85rem;font-family:var(--font-body);outline:none;
                                  transition:border-color 150ms;box-sizing:border-box;"
                           onfocus="this.style.borderColor='var(--accent)'"
                           onblur="this.style.borderColor='var(--border)'" />
                </div>
            </div>

            <div style="margin-bottom:1rem;">
                <label style="display:block;font-family:var(--font-mono);font-size:0.65rem;
                              text-transform:uppercase;letter-spacing:0.1em;color:var(--text-dim);
                              margin-bottom:0.4rem;">Subject</label>
                <input type="text" name="subject" required maxlength="200"
                       placeholder="What's this about?"
                       style="width:100%;background:var(--bg);border:1px solid var(--border);
                              border-radius:6px;padding:0.55rem 0.75rem;color:var(--text);
                              font-size:0.85rem;font-family:var(--font-body);outline:none;
                              transition:border-color 150ms;box-sizing:border-box;"
                       onfocus="this.style.borderColor='var(--accent)'"
                       onblur="this.style.borderColor='var(--border)'" />
            </div>

            <div style="margin-bottom:1.5rem;">
                <label style="display:block;font-family:var(--font-mono);font-size:0.65rem;
                              text-transform:uppercase;letter-spacing:0.1em;color:var(--text-dim);
                              margin-bottom:0.4rem;">Message</label>
                <textarea name="message" required maxlength="2000" rows="6"
                          placeholder="Describe your issue or feedback..."
                          style="width:100%;background:var(--bg);border:1px solid var(--border);
                                 border-radius:6px;padding:0.55rem 0.75rem;color:var(--text);
                                 font-size:0.85rem;font-family:var(--font-body);outline:none;
                                 transition:border-color 150ms;resize:vertical;
                                 box-sizing:border-box;line-height:1.6;"
                          onfocus="this.style.borderColor='var(--accent)'"
                          onblur="this.style.borderColor='var(--border)'"></textarea>
                <div style="text-align:right;font-family:var(--font-mono);font-size:0.65rem;
                            color:var(--text-dim);margin-top:0.3rem;" id="charCount">
                    0 / 2000
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;">
                <button type="submit"
                        style="background:var(--accent);color:#fff;border:none;
                               padding:0.6rem 1.5rem;border-radius:7px;font-size:0.85rem;
                               font-weight:600;cursor:pointer;font-family:var(--font-body);
                               transition:opacity 150ms;"
                        onmouseover="this.style.opacity='0.85'"
                        onmouseout="this.style.opacity='1'">
                    <i class="fa-solid fa-paper-plane fa-xs" style="margin-right:0.4rem;"></i>
                    Send Message
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        @@keyframes uj-blink { 0%,100%{opacity:1} 50%{opacity:0.25} }
    </style>
    <script>
        const textarea = document.querySelector('textarea[name="message"]');
        const counter  = document.getElementById('charCount');
        if (textarea && counter) {
            textarea.addEventListener('input', () => {
                counter.textContent = `${textarea.value.length} / 2000`;
                counter.style.color = textarea.value.length > 1800 ? 'var(--accent)' : 'var(--text-dim)';
            });
        }
    </script>
}
